# Dockerfile.catalog-worker — servico `cinerie-catalog-worker` (espelho TMDB).
#
# MESMO PADRAO do `Dockerfile.publication-worker`, que ja roda em producao: base
# pinada por digest, pnpm via corepack, usuario nao-root, HEALTHCHECK com o fetch
# global do Node, `exec` para o processo ser PID 1 e receber SIGTERM direto.
#
# O QUE ESTE SERVICO FAZ: mantem o loop da fila `catalog_jobs` rodando e
# enfileira periodicamente a descoberta (Daily ID Exports) e o `/changes`
# incremental. Toda a maquina ja existia em `services/ingestion`; a imagem so
# lhe da um veiculo de execucao.
#
# ================== SEGREDOS: FILE MOUNT, NUNCA --build-arg ==================
# Um segredo passado como `--build-arg` VAZA em dois lugares ao mesmo tempo: no
# log de build (que o painel mostra) e nas CAMADAS da imagem (`docker history` o
# devolve). Isso ja aconteceu neste projeto. Por isso:
#
#   - NENHUM `ARG` aqui recebe credencial. Os unicos `ARG` sao metadados de
#     build (SHA, versao, data), que sao publicos por natureza;
#   - `DATABASE_URL` e `TMDB_READ_ACCESS_TOKEN` entram em RUNTIME, por File
#     Mount, como no `cinerie-cms`;
#   - o build NAO precisa de banco nem de token: `prisma generate` le o schema e
#     emite codigo, sem tocar em rede.
#
# Este servico NUNCA aplica migration no `screen-db`: a migration publica
# pertence ao processo governado do banco. Ele apenas RECUSA readiness enquanto
# `catalog_jobs` nao existir.
#
# IMAGENS FICAM NO TMDB: o espelho guarda `poster_path`, `backdrop_path` e
# `profile_path` e serve por `image.tmdb.org`. Nenhum byte de imagem entra no
# nosso storage — por isso esta imagem nao monta volume de midia.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
FROM ${NODE_IMAGE}

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY . .

RUN PNPM_CONFIG_PROD=false pnpm install --frozen-lockfile

# O servico importa `@screena/db/server` -> `@prisma/client`. O client so existe
# apos `prisma generate`; o postinstall do pacote roda dentro do store do pnpm e
# nao alcanca `packages/db/prisma/schema.prisma`.
#
# `generate` NAO toca banco — le o schema e emite codigo. Nenhuma migration
# acontece em tempo de build, aqui ou em qualquer outro passo.
RUN pnpm --filter @screena/db db:generate

ENV NODE_ENV=production
ENV CATALOG_WORKER_HEALTH_PORT=3004

ARG CINERIE_BUILD_SHA=unknown
ARG CINERIE_BUILD_VERSION=unknown
ARG CINERIE_BUILD_TIME=unknown
ENV CINERIE_BUILD_SHA=${CINERIE_BUILD_SHA} \
    CINERIE_BUILD_VERSION=${CINERIE_BUILD_VERSION} \
    CINERIE_BUILD_TIME=${CINERIE_BUILD_TIME}

RUN chown -R node:node /app
USER node

EXPOSE 3004

# LIVENESS, nao readiness — pelo mesmo motivo do publication-worker: um
# healthcheck que dependesse do banco reiniciaria em loop um worker saudavel
# durante uma queda do PostgreSQL, e reiniciar nao devolve o banco.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3004/healthz').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"

# `exec` para que o servico seja PID 1 e receba SIGTERM direto: o encerramento
# gracioso (parar de reivindicar, terminar os jobs em voo, devolver as linhas
# `running`) depende de o sinal chegar ao processo certo, e nao a um shell pai.
CMD ["sh", "-c", "exec pnpm --filter @screena/ingestion catalog-worker:start"]
