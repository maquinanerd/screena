#!/bin/sh
# pre-push versionado da Cinerie: CI local no perfil rapido (typecheck, lint,
# test, auditorias, build do web). Mesma logica de `corepack pnpm run prepush`.
# Liga com `corepack pnpm run hooks:install`. Pular uma vez: `git push --no-verify`.
[ "${CINERIE_SKIP_HOOKS:-}" = "1" ] && { echo "pre-push: CINERIE_SKIP_HOOKS=1, pulando"; exit 0; }

# Push que so apaga branch remota (sha local zerado) nao tem o que validar.
validar=0
while read -r _ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) validar=1 ;;
  esac
done
[ "$validar" = "0" ] && exit 0

exec node scripts/ci/pipeline.mjs rapido --hook pre-push
