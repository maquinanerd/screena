{
  "$schema": "opapreco-ads/tokens@1",
  "color": {
    "background": "#FFFFFF",
    "surface": "#F7F7F7",
    "surfaceHover": "#F0F0F0",
    "border": "#E6E6E6",
    "borderHover": "#CFCFCF",
    "divider": "#D4D4D4",
    "textPrimary": "#111111",
    "textSecondary": "#666666",
    "textBody": "#444444",
    "action": "#0B6E4F",
    "actionHover": "#095A41",
    "actionActive": "#074633",
    "actionFg": "#FFFFFF",
    "actionSubtle": "#EDF5F1",
    "actionSubtleActive": "#DCEDE4",
    "positive": "#0B6E4F",
    "positiveBg": "#EDF5F1",
    "disabledBg": "#F0F0F0",
    "disabledFg": "#666666",
    "focusRing": "#0B6E4F",
    "skeleton": "#EEEEEE",
    "imageBg": "#F7F7F7",
    "imagePlaceholderIcon": "#9A9A9A"
  },
  "font": {
    "family": "inherit",
    "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif",
    "numeric": "tabular-nums"
  },
  "type": {
    "eyebrow": { "size": 12, "line": 16, "weight": 400, "brandWeight": 700 },
    "eyebrowHero": { "size": 13, "line": 16 },
    "contextLabel": { "size": 12, "line": 16, "weight": 700, "tracking": "0.06em", "transform": "uppercase" },
    "contextHeading": { "size": 18, "line": 1.3, "weight": 700 },
    "title": { "size": 17, "line": 1.3, "weight": 600 },
    "titleCompact": { "size": 15, "line": 1.3, "weight": 600 },
    "titleHero": { "size": 18, "line": 1.3, "weight": 600 },
    "priceHero": { "size": 28, "line": 34, "weight": 700, "tracking": "-0.015em" },
    "priceDrop": { "size": 26, "line": 32, "weight": 700 },
    "price": { "size": 24, "line": 30, "weight": 700, "tracking": "-0.01em" },
    "priceContextual": { "size": 22, "line": 28, "weight": 700 },
    "priceCompact": { "size": 20, "line": 24, "weight": 700 },
    "priceReference": { "size": 13, "weight": 400, "decoration": "line-through" },
    "discount": { "size": 12, "line": 18, "weight": 700 },
    "meta": { "size": 12, "line": 16, "weight": 400 },
    "disclosure": { "size": 11, "line": 16, "weight": 400 },
    "cta": { "size": 15, "weight": 600 },
    "ctaHero": { "size": 16, "weight": 600 },
    "ctaSecondary": { "size": 14, "weight": 600 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32 },
  "radius": { "badge": 4, "image": 6, "cta": 6, "card": 8, "hero": 12 },
  "border": { "width": 1, "contextTopRule": 2 },
  "shadow": { "none": "none" },
  "motion": { "duration": "120ms", "easing": "ease", "collapse": "200ms" },
  "cta": {
    "minHeight": 44, "minHeightHero": 48, "paddingX": 16, "paddingXHero": 20, "radius": 6,
    "primary": { "bg": "#0B6E4F", "fg": "#FFFFFF", "hover": "#095A41", "active": "#074633" },
    "secondary": { "bg": "#FFFFFF", "fg": "#0B6E4F", "border": "#0B6E4F", "hover": "#EDF5F1", "active": "#DCEDE4" },
    "icon": { "size": 14, "stroke": 1.75 }
  },
  "badge": {
    "disclosure": { "fg": "#666666", "border": "#E6E6E6", "radius": 4, "paddingX": 6, "size": 11 },
    "discount": { "fg": "#0B6E4F", "bg": "#EDF5F1", "radius": 4, "paddingX": 6, "size": 12 }
  },
  "image": {
    "fit": "contain", "bg": "#F7F7F7", "radius": 6, "blend": "multiply",
    "card": { "desktop": "160x160", "mobile": "100% x 180" },
    "compact": "56x56",
    "hero": { "desktop": "flex 300px x 300", "mobile": "100% x 300" },
    "grid": "100% x 140",
    "priceDrop": "120x120 (mobile 100% x 120)",
    "contextual": "88x88"
  },
  "focus": { "outline": "2px solid #0B6E4F", "offset": 2 },
  "breakpoints": { "mobile": "<768", "tablet": "768-1023", "desktop": ">=1024", "reference": 1440 },
  "containerThresholds": {
    "product_card_v1": { "verticalBelow": 480 },
    "product_hero_v1": { "verticalBelow": 600 },
    "price_drop_v1": { "verticalBelow": 430 },
    "contextual_recommendation_v1": { "ctaWrapsBelow": 520 },
    "product_grid_v1": { "columnMin": 150, "maxColumns": 4, "gap": 12 }
  }
}
