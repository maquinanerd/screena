# =============================================================================
# Screena — exemplo de variaveis de ambiente
# -----------------------------------------------------------------------------
# IMPORTANTE: chaves e segredos vivem SO em variaveis de ambiente.
#   - NUNCA exponha chaves no frontend / em codigo enviado ao navegador.
#   - NUNCA versione um arquivo .env real (apenas este .env.example entra no git).
#   - Copie este arquivo para .env e preencha com valores reais no ambiente.
# =============================================================================

# Conexao PostgreSQL — unica fonte de dados em paginas indexaveis (render le SO o banco/cache).
SCREENA_DATABASE_URL=postgresql://user:password@localhost:5432/screena

# URL publica canonica do site (usada em SEO, sitemap, canonical, schema).
SCREENA_PUBLIC_SITE_URL=https://screena.media

# Chave da TMDB — usada SO offline por workers de sync, nunca no render.
SCREENA_TMDB_API_KEY=

# Chave do Gemini — IA gera content_blocks SO offline, nunca no render.
SCREENA_GEMINI_API_KEY=

# Chave do provedor tecnico de ratings (ex.: RapidAPI) — provider_api != rating_source.
SCREENA_RATINGS_PROVIDER_KEY=

# Chave do provedor tecnico de disponibilidade de streaming (onde assistir) — uso offline.
SCREENA_STREAMING_PROVIDER_KEY=

# Conexao Redis — cache local para leitura no render (sem API externa).
SCREENA_REDIS_URL=redis://localhost:6379

# Ambiente de execucao: development | test | production
NODE_ENV=development
