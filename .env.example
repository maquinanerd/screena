# =============================================================================
# Cinerie — exemplo de variaveis de ambiente
# -----------------------------------------------------------------------------
# IMPORTANTE: chaves e segredos vivem SO em variaveis de ambiente.
#   - NUNCA exponha chaves no frontend / em codigo enviado ao navegador.
#   - NUNCA versione um arquivo .env real (apenas este .env.example entra no git).
#   - Copie este arquivo para .env e preencha com valores reais no ambiente.
#
# Cada NOME abaixo e exatamente o nome que o codigo LE (verificado no Prompt 01,
# baseline R-08/R-09). Um operador que preencher este arquivo sobe os runtimes
# reais (auth/e-mail, admin, ratings, streaming) sem falha de configuracao.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (obrigatorio)
# -----------------------------------------------------------------------------
# PostgreSQL local de desenvolvimento (docker-compose.dev.yml).
# A senha abaixo e placeholder local; troque no seu .env se necessario.
POSTGRES_PASSWORD="screena_dev_password"
DATABASE_URL="postgresql://screena:screena_dev_password@localhost:5432/screena"

# -----------------------------------------------------------------------------
# Origem publica e indexacao (apps/web/src/lib/site.ts)
# -----------------------------------------------------------------------------
# NOMES CANONICOS: CINERIE_PUBLIC_SITE_URL / CINERIE_PUBLIC_INDEXING_ENABLED.
# Producao oficial DEVE usar exatamente https://cinerie.com. Local/dev/preview/
# staging usam a propria origem; o robots bloqueia indexacao quando a origem
# nao e a oficial (fail-closed).
CINERIE_PUBLIC_SITE_URL=http://localhost:3000
# Indexacao publica so deve ser ligada na producao oficial (Prompt 13):
# CINERIE_PUBLIC_SITE_URL=https://cinerie.com
# CINERIE_PUBLIC_INDEXING_ENABLED=1
CINERIE_PUBLIC_INDEXING_ENABLED=0
# Nomes LEGADOS (marca anterior). Ainda lidos como FALLBACK apenas enquanto os
# nomes CINERIE_* acima nao estiverem definidos. Nao configure os dois; prefira
# os canonicos. Remover apos migrar todos os ambientes.
# THE_SCREEN_PUBLIC_SITE_URL=https://cinerie.com
# THE_SCREEN_PUBLIC_INDEXING_ENABLED=1

# -----------------------------------------------------------------------------
# Runtime de autenticacao e e-mail transacional (services/user-platform)
# Alcancado pelas rotas /api/auth/** do app publico. WIRED em producao: sem
# estas variaveis, a primeira chamada de auth falha no boot da composicao.
# (services/user-platform/src/auth-runtime/config.ts)
# -----------------------------------------------------------------------------
# OBRIGATORIAS (sem default seguro — chave vazia recusa o boot, nao degrada):
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=
# Origem publica do app para montar os links de e-mail. Producao exige HTTPS,
# sem caminho/query/fragmento/credencial embutidos. Distinta de
# CINERIE_PUBLIC_SITE_URL (esta e a origem do link de e-mail).
PUBLIC_APP_URL=http://localhost:3000
# Prazos de validade dos tokens, em MINUTOS (inteiro positivo; teto 43200 = 30d):
PASSWORD_RESET_EXPIRATION_MINUTES=60
EMAIL_VERIFICATION_EXPIRATION_MINUTES=1440
# OPCIONAIS:
# E-mail de resposta (reply-to). Ausente = sem reply-to.
BREVO_REPLY_TO_EMAIL=
# Sal do hash de IP do throttle. Ausente = sal efemero por processo (a contagem
# por IP deixa de ser correlacionavel entre reinicios/replicas). Min. 16 chars.
CINERIE_IP_HASH_SALT=

# -----------------------------------------------------------------------------
# Painel admin (apps/admin) — protecao e escrita editorial
# (apps/admin/src/lib/access-protection.ts e editorial-action-policy.ts)
# -----------------------------------------------------------------------------
# Em producao a protecao e EXIGIDA (fail-closed). Fora de producao, ligue
# explicitamente com ADMIN_PROTECTION_ENABLED=true para exercitar o Basic Auth.
ADMIN_PROTECTION_ENABLED=false
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=
# Escrita editorial (revisao/publicacao) fica DESLIGADA por default. So "true"
# habilita a escrita; qualquer outro valor mantem o admin somente-leitura.
ADMIN_EDITORIAL_ACTIONS_ENABLED=false

# -----------------------------------------------------------------------------
# TMDB — usado SO offline por services/ingestion ou services/sync, nunca no render.
# -----------------------------------------------------------------------------
# Variaveis canonicas:
#   1. TMDB_READ_ACCESS_TOKEN (v4, preferido; tem precedencia quando preenchido)
#   2. TMDB_API_KEY (v3, fallback quando o token v4 estiver ausente)
# Nome legado NAO lido pelo client atual: SCREENA_TMDB_API_KEY.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_API_BASE_URL=
TMDB_DEFAULT_LANGUAGE=pt-BR
TMDB_MAX_RPS=20
TMDB_MAX_RETRIES=4
TMDB_BREAKER_THRESHOLD=5
TMDB_BREAKER_COOLDOWN_MS=30000
TMDB_CACHE_TTL_MS=86400000
# Safety valve opcional do sync raw (services/ingestion/bin/sync-tmdb-raw.ts).
# RAW_SYNC_MAX_REQUESTS=

# -----------------------------------------------------------------------------
# Ratings externos (RapidAPI: Film & Show Ratings) — offline, provider tecnico.
# provider_api != rating_source. (api-clients/film_show_ratings/src/config.ts)
# -----------------------------------------------------------------------------
# OBRIGATORIA para o worker de ratings:
RAPIDAPI_FILM_SHOW_RATINGS_KEY=
# OPCIONAIS (override de host/base e ajuste fino; ha defaults no client):
# RAPIDAPI_FILM_SHOW_RATINGS_HOST=
# RAPIDAPI_FILM_SHOW_RATINGS_BASE_URL=
# RAPIDAPI_FILM_SHOW_RATINGS_MAX_RPS=2
# RAPIDAPI_FILM_SHOW_RATINGS_MAX_RETRIES=3
# RAPIDAPI_FILM_SHOW_RATINGS_BREAKER_THRESHOLD=5
# RAPIDAPI_FILM_SHOW_RATINGS_BREAKER_COOLDOWN_MS=30000
# RAPIDAPI_FILM_SHOW_RATINGS_TIMEOUT_MS=15000
# RAPIDAPI_FILM_SHOW_RATINGS_CACHE_TTL_MS=

# -----------------------------------------------------------------------------
# Streaming / onde assistir (RapidAPI: Streaming Availability) — offline.
# (api-clients/streaming_availability/src/config.ts)
# -----------------------------------------------------------------------------
# OBRIGATORIA para o worker de streaming:
RAPIDAPI_STREAMING_AVAILABILITY_KEY=
# OPCIONAIS:
# RAPIDAPI_STREAMING_AVAILABILITY_HOST=
# RAPIDAPI_STREAMING_AVAILABILITY_BASE_URL=
# RAPIDAPI_STREAMING_AVAILABILITY_MAX_RPS=2
# RAPIDAPI_STREAMING_AVAILABILITY_MAX_RETRIES=3
# RAPIDAPI_STREAMING_AVAILABILITY_BREAKER_THRESHOLD=5
# RAPIDAPI_STREAMING_AVAILABILITY_BREAKER_COOLDOWN_MS=30000
# RAPIDAPI_STREAMING_AVAILABILITY_TIMEOUT_MS=15000
# RAPIDAPI_STREAMING_AVAILABILITY_CACHE_TTL_MS=

# -----------------------------------------------------------------------------
# Gemini — IA gera content_blocks SO offline, nunca no render.
# -----------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Gemini opcionais — deixe em branco/ajuste apenas no worker offline.
GEMINI_API_BASE_URL=
GEMINI_MAX_RPS=1
GEMINI_MAX_RETRIES=3
GEMINI_BREAKER_THRESHOLD=5
GEMINI_BREAKER_COOLDOWN_MS=30000

# -----------------------------------------------------------------------------
# Redis — NAO lido por nenhum codigo atual (roadmap). Mantido como referencia;
# nao e necessario para subir o app. Sera ativado quando houver leitor real.
# -----------------------------------------------------------------------------
# SCREENA_REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Ambiente e operacao
# -----------------------------------------------------------------------------
# Ambiente de execucao: development | test | production
NODE_ENV=development

# Operacao: backups PostgreSQL. BACKUP_DIR deve apontar para volume persistente
# fora do repositorio; os dumps contem dados sensiveis/licenciados.
BACKUP_DIR=/home/screen/backups
BACKUP_PREFIX=screen-postgres
# Opcional: destino off-site via rclone (ex.: s3:screen-backups/postgres).
BACKUP_OFFSITE_RCLONE_REMOTE=

# Restore-test sempre mira uma base efemera/isolada.
RESTORE_TEST_ADMIN_URL=
RESTORE_TEST_DATABASE_URL=
