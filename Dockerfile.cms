# Dockerfile.cms — servico `cinerie-cms` (Payload).
#
# Mesmo PADRAO do `Dockerfile` do screen-app: base pinada por digest, pnpm via
# corepack, usuario nao-root, HEALTHCHECK com o fetch global do Node. Introduzir
# multi-stage ou buildpack SO neste servico criaria dois padroes de deploy no
# mesmo repositorio, e o segundo sempre envelhece.
#
# ISOLAMENTO (ADR 0015): esta imagem NAO recebe `DATABASE_URL`, nao roda Prisma e
# nao conhece o `screen-db`. Ela fala com o proprio banco editorial
# (`PAYLOAD_DATABASE_URL`) e com mais nada.
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
FROM ${NODE_IMAGE}

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

COPY . .

# `NODE_ENV` so entra depois do build: com `production` o pnpm pula as
# devDependencies, e tanto o `next build` quanto o CLI do Payload dependem delas.
RUN PNPM_CONFIG_PROD=false pnpm install --frozen-lockfile

# BUILD SEM BANCO E SEM SEGREDO REAL.
#
# `payload.config.ts` valida a configuracao no import, e o `next build` importa o
# config para gerar o admin. Os valores abaixo sao literais fixos de BUILD. Eles
# NAO sao `ARG`: um orquestrador que transforma variaveis de runtime em build args
# nao consegue sobrescreve-los com credenciais reais.
#
# O host `127.0.0.1:1` e deliberadamente inalcancavel: se alguma etapa do build
# tentar abrir conexao, ela falha em vez de tocar um banco real.
#
# O driver de BUILD e `s3` com endpoint inalcancavel, e nao `local`. `local` sob
# `NODE_ENV=production` exigiria uma declaracao de persistencia que nao pertence
# ao build.
RUN PAYLOAD_SECRET=build-only-secret-nao-usar-em-runtime-0123456789 \
    PAYLOAD_DATABASE_URL=postgresql://build:build@127.0.0.1:1/cinerie_cms_build \
    PAYLOAD_UPLOAD_STORAGE_DRIVER=s3 \
    PAYLOAD_UPLOAD_S3_ENDPOINT=http://127.0.0.1:1 \
    PAYLOAD_UPLOAD_S3_BUCKET=build-only \
    PAYLOAD_UPLOAD_S3_ACCESS_KEY_ID=build-only \
    PAYLOAD_UPLOAD_S3_SECRET_ACCESS_KEY=build-only \
    pnpm --filter @screena/cms build

ENV NODE_ENV=production
ENV PORT=3002

ARG CINERIE_BUILD_SHA=unknown
ARG CINERIE_BUILD_VERSION=unknown
ARG CINERIE_BUILD_TIME=unknown
ENV CINERIE_BUILD_SHA=${CINERIE_BUILD_SHA} \
    CINERIE_BUILD_VERSION=${CINERIE_BUILD_VERSION} \
    CINERIE_BUILD_TIME=${CINERIE_BUILD_TIME}

# Container NAO-root. O diretorio de uploads locais e criado aqui com dono
# `node` para que um volume montado por cima herde permissao utilizavel.
RUN mkdir -p /app/apps/cms/media /run/secrets && chown -R node:node /app /run/secrets
USER node

EXPOSE 3002

# LIVENESS, nao readiness. `/healthz` nao toca banco: se o healthcheck do
# container dependesse do PostgreSQL, uma queda do banco faria o orquestrador
# REINICIAR em loop um container saudavel — e reiniciar nao devolve o banco.
# Quem tira do balanceador e `/readyz`, configurado no orquestrador.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3002/healthz').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"

# SEGREDOS DE RUNTIME.
#
# EasyPanel pode disponibilizar variaveis de Ambiente tambem como build args. Para
# impedir que banco e segredo aparecam na linha de `docker build`, o deploy pode
# monta-los como arquivos:
#   /run/secrets/payload_database_url
#   /run/secrets/payload_secret
#
# Variaveis de runtime continuam aceitas para outros orquestradores. Os arquivos
# so sao lidos quando a variavel correspondente estiver ausente.
#
# MIGRATION ANTES DO START, e o app NAO sobe se ela falhar. `exec` mantem o Next
# como PID 1 para receber SIGTERM diretamente.
CMD ["sh", "-c", "if [ -z \"${PAYLOAD_DATABASE_URL:-}\" ] && [ -f /run/secrets/payload_database_url ]; then export PAYLOAD_DATABASE_URL=\"$(cat /run/secrets/payload_database_url)\"; fi; if [ -z \"${PAYLOAD_SECRET:-}\" ] && [ -f /run/secrets/payload_secret ]; then export PAYLOAD_SECRET=\"$(cat /run/secrets/payload_secret)\"; fi; pnpm --filter @screena/cms cms:migrations:deploy || { echo '=== FATAL: migration do Payload falhou. O CMS NAO vai subir. ==='; echo '=== Runbook: docs/runbooks/EASYPANEL_EDITORIAL.md'; exit 1; }; exec pnpm --filter @screena/cms start"]
