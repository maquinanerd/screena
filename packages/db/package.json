{
  "name": "@screena/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Camada de dados do Screen (namespace tecnico legado @screena/db): schema Prisma, migrations, seeds e dados de semente tipados. Pipelines offline escrevem, web le server-side. NENHUM client de DB ou API no render publico.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:validate:real": "tsx scripts/validate-real-postgres.ts",
    "db:validate:upgrade": "tsx scripts/validate-upgrade-real-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@screena/config": "workspace:*"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0"
  }
}
