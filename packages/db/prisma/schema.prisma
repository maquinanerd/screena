model NewsCluster {
  id                BigInt            @id @default(autoincrement())
  externalClusterId String?           @unique @map("external_cluster_id")
  eventKey          String?           @unique @map("event_key")
  fingerprint       String            @unique
  topic             String?
  title             String
  summary           String?
  languageCode      String?           @map("language_code")
  countryCode       String?           @map("country_code")
  sourceCount       Int               @default(0) @map("source_count")
  confidence        Float?
  primarySource     String?           @map("primary_source")
  payload           Json
  payloadHash       String            @map("payload_hash")
  status            NewsClusterStatus @default(captured)
  firstSeen         DateTime?         @map("first_seen")
  lastSeen          DateTime?         @map("last_seen")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sources           NewsClusterSource[]
  urls              NewsClusterUrl[]
  decisions         NewsEditorialDecision[]
  facts             NewsFact[]
  entityCandidates  NewsEntityCandidate[]
  checkpoints       NewsPipelineCheckpoint[]
  deadLetters       NewsDeadLetter[]
  article           Article?

  @@index([status])
  @@index([topic])
  @@map("news_clusters")
}

model NewsClusterSource {
  id              BigInt   @id @default(autoincrement())
  clusterId       BigInt   @map("cluster_id")
  sourceName      String   @map("source_name")
  sourceUrl       String?
  sourceLicenseId BigInt?  @map("source_license_id")
  blocked         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  cluster       NewsCluster    @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  sourceLicense SourceLicense? @relation(fields: [sourceLicenseId], references: [id], onDelete: SetNull)

  @@unique([clusterId, sourceName])
  @@map("news_cluster_sources")
}

model NewsClusterUrl {
  id           BigInt   @id @default(autoincrement())
  clusterId    BigInt   @map("cluster_id")
  url          String
  canonicalUrl String?  @map("canonical_url")
  createdAt    DateTime @default(now()) @map("created_at")

  cluster NewsCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, url])
  @@index([canonicalUrl])
  @@map("news_cluster_urls")
}

model NewsEditorialDecision {
  id            BigInt                    @id @default(autoincrement())
  clusterId     BigInt                    @map("cluster_id")
  decision      NewsEditorialDecisionKind
  score         Float
  policyVersion String                    @map("policy_version")
  reasonsJson   Json                      @map("reasons_json")
  signalsJson   Json                      @map("signals_json")
  warningsJson  Json?                     @map("warnings_json")
  createdAt     DateTime                  @default(now()) @map("created_at")

  cluster NewsCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([clusterId, createdAt])
  @@map("news_editorial_decisions")
}

model NewsFact {
  id             BigInt   @id @default(autoincrement())
  clusterId      BigInt   @map("cluster_id")
  factType       String   @map("fact_type")
  valueJson      Json     @map("value_json")
  sourceUrl      String?  @map("source_url")
  sourceLicenseId BigInt? @map("source_license_id")
  confidence     Float?
  fingerprint    String
  conflictKey    String?  @map("conflict_key")
  extractedAt    DateTime @default(now()) @map("extracted_at")

  cluster       NewsCluster    @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  sourceLicense SourceLicense? @relation(fields: [sourceLicenseId], references: [id], onDelete: SetNull)

  @@unique([clusterId, fingerprint])
  @@index([clusterId, conflictKey])
  @@map("news_facts")
}

model NewsEntityCandidate {
  id         BigInt                      @id @default(autoincrement())
  clusterId  BigInt                      @map("cluster_id")
  entityType EntityType                  @map("entity_type")
  entityId   BigInt                      @map("entity_id")
  confidence Float
  evidence   Json
  decision   NewsEntityCandidateDecision @default(pending)
  decidedBy  String?                     @map("decided_by")
  decidedAt  DateTime?                   @map("decided_at")
  createdAt  DateTime                    @default(now()) @map("created_at")

  cluster NewsCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([clusterId, entityType, entityId])
  @@map("news_entity_candidates")
}

model NewsPipelineCheckpoint {
  id          BigInt   @id @default(autoincrement())
  pipeline    String
  topic       String?
  cursor      String?
  etag        String?
  lastModified String? @map("last_modified")
  clusterId   BigInt?  @map("cluster_id")
  heartbeatAt DateTime @default(now()) @map("heartbeat_at")
  done        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cluster NewsCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@unique([pipeline, topic])
  @@map("news_pipeline_checkpoints")
}

model NewsDeadLetter {
  id          BigInt   @id @default(autoincrement())
  clusterId   BigInt?  @map("cluster_id")
  stage       String
  errorCode   String   @map("error_code")
  attempts    Int      @default(1)
  payloadJson Json?    @map("payload_json")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime @default(now()) @map("created_at")

  cluster NewsCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([resolvedAt])
  @@map("news_dead_letters")
}
