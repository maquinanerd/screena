// ============================================================
// RATINGS / LICENCA (polimorfico)
// ============================================================

model ExternalRating {
  id                  BigInt        @id @default(autoincrement())
  entityType          EntityType    @map("entity_type")
  entityId            BigInt        @map("entity_id")
  ratingSource        String        @map("rating_source") // FK -> rating_sources.key (fonte editorial)
  ratingLabel         String        @map("rating_label")
  metric              String
  ratingValue         Decimal       @map("rating_value")
  ratingScale         Int           @map("rating_scale") // deve casar com rating_sources.scale (teste)
  ratingCount         Int?          @map("rating_count")
  ratingUrl           String?       @map("rating_url")
  providerApi         String        @map("provider_api") // FK -> api_providers.key (fornecedor tecnico)
  providerPayloadHash String?       @map("provider_payload_hash")
  fetchedAt           DateTime?     @map("fetched_at")
  attributionText     String?       @map("attribution_text")
  attributionUrl      String?       @map("attribution_url")
  licenseStatus       LicenseStatus @default(unknown) @map("license_status")
  displayAllowed      Boolean       @default(false) @map("display_allowed") // default seguro (inv. 6)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // --- Governanca de exibicao (Backend B) ---
  // Ate aqui o fail-closed de ratings era SO aplicacao: o banco aceitava
  // display_allowed=true sem revisor, sem hash e sem licenca. O default
  // protegia o caminho feliz, nao o caminho errado. Os campos abaixo + os
  // triggers `external_ratings_integrity_guard_trg` e
  // `external_ratings_display_guard_trg` fecham isso.
  scoreType           RatingScoreType? @map("score_type") // null = nao classificado => nunca exibivel
  requiresAttribution Boolean          @default(true) @map("requires_attribution")
  requiresLinkback    Boolean          @default(true) @map("requires_linkback")
  reviewedAt          DateTime?        @map("reviewed_at")
  reviewedBy          String?          @map("reviewed_by") // identidade humana; exigido para exibir
  // Fingerprint APROVADO do payload (external_rating_payload_fingerprint_v1,
  // computado no banco). Se a nota muda (valor, votos, atribuicao...), o hash
  // deixa de bater e o trigger derruba a exibicao: "mudanca revoga".
  approvedPayloadHash String?          @map("approved_payload_hash")
  staleAfter          DateTime?        @map("stale_after") // derivado de RATING_STALE_POLICY
  dataUsageDecisionId BigInt?          @map("data_usage_decision_id")

  // Invariante 2 materializada: rating_source e provider_api -> tabelas DISTINTAS.
  source            RatingSource       @relation(fields: [ratingSource], references: [key])
  provider          ApiProvider        @relation(fields: [providerApi], references: [key])
  dataUsageDecision DataUsageDecision? @relation(fields: [dataUsageDecisionId], references: [id])

  @@unique([entityType, entityId, ratingSource, metric])
  @@index([entityType, entityId])
  @@index([ratingSource])
  @@index([providerApi])
  @@index([scoreType])
  @@index([staleAfter])
  @@index([dataUsageDecisionId])
  @@map("external_ratings")
}

// EntityAward — o FATO DE PREMIACAO de um titulo ("Won 4 Oscars. 160 wins &
// 220 nominations total"), promovido de `api_cache` para o dominio.
//
// POR QUE TABELA PROPRIA, E NAO COLUNA EM movies/tv_shows:
//  1. o dado carrega GOVERNANCA (licenca, credito, decisao de uso, hash
//     aprovado, display_allowed). Isso e meia duzia de colunas que nao
//     pertencem a ficha da obra e teriam de ser duplicadas em movies E em
//     tv_shows;
//  2. `entity_type` + `entity_id` cobre as duas verticais com UMA tabela, como
//     `external_ratings` ja faz;
//  3. um titulo tem UMA frase de premiacao por provedor tecnico — o UNIQUE
//     (entity_type, entity_id, provider_api) e a identidade real do objeto, e
//     nao caberia numa coluna.
//
// POR QUE NAO E `external_ratings`: premio NAO e nota. Nao tem escala, nao tem
// natureza critica/publico, nao tem valor numerico comparavel e nao passa pelo
// gate de `score_allowed`. Enfia-lo la exigiria uma escala falsa e faria o
// trigger de rating julgar um dado que ele nao entende.
//
// O BRUTO FICA JUNTO DO PARSEADO (`awards_raw`): se a OMDb mudar o formato da
// frase, o bruto e o que permite reprocessar sem gastar uma chamada nova. O
// parseado e o que a tela consegue escrever em pt-BR.
//
// Fail-closed igual ao resto: `display_allowed` nasce false e so vira true sob
// o trigger `entity_awards_display_guard_trg` (licenca vigente + credito +
// decisao `awards_display` + hash batendo). Ver
// docs/legal/omdb-awards-source-provenance.md para a decisao de fonte pendente.
model EntityAward {
  id        BigInt     @id @default(autoincrement())
  entityType EntityType @map("entity_type")
  entityId   BigInt     @map("entity_id")

  // --- O fato, como a fonte escreveu e como o reconhecedor o leu ---
  // Literal integral do campo `Awards`. NUNCA vazio: titulo sem premio nao vira
  // linha (CHECK no banco).
  awardsRaw String  @map("awards_raw")
  // Destaque decomposto. `award_name` e VERBATIM ("Oscars", "Primetime Emmys"):
  // traduzir nome de premio e inventar um premio.
  outcome        String? // 'won' | 'nominated' (CHECK); null = frase so com contagem
  highlightCount Int?    @map("highlight_count")
  awardName      String? @map("award_name")
  // Contagem agregada; null quando a frase nao a declara. NUNCA 0 por inferencia.
  wins        Int?
  nominations Int?

  // --- Proveniencia tecnica (invariante 2: nao e a fonte editorial) ---
  providerApi         String    @map("provider_api") // FK -> api_providers.key
  providerPayloadHash String?   @map("provider_payload_hash")
  fetchedAt           DateTime? @map("fetched_at")

  // --- Governanca de exibicao (espelha external_ratings) ---
  // Fonte EDITORIAL do fato. `null` = ainda nao decidida => nunca exibivel.
  // Nao ha FK: premio nao vem de `rating_sources` (aquilo e dominio de nota).
  sourceKey           String?       @map("source_key")
  attributionText     String?       @map("attribution_text")
  attributionUrl      String?       @map("attribution_url")
  requiresAttribution Boolean       @default(true) @map("requires_attribution")
  requiresLinkback    Boolean       @default(true) @map("requires_linkback")
  licenseStatus       LicenseStatus @default(unknown) @map("license_status")
  displayAllowed      Boolean       @default(false) @map("display_allowed") // default seguro (inv. 6)
  // Fingerprint APROVADO (entity_award_payload_fingerprint_v1, computado NO
  // BANCO). Mudou a frase ou o credito, o hash deixa de bater e a exibicao cai.
  approvedPayloadHash String?       @map("approved_payload_hash")
  dataUsageDecisionId BigInt?       @map("data_usage_decision_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provider          ApiProvider        @relation(fields: [providerApi], references: [key])
  dataUsageDecision DataUsageDecision? @relation(fields: [dataUsageDecisionId], references: [id])

  @@unique([entityType, entityId, providerApi])
  @@index([entityType, entityId])
  @@index([providerApi])
  @@index([sourceKey])
  @@index([displayAllowed])
  @@index([dataUsageDecisionId])
  @@map("entity_awards")
}

// ============================================================
// DISPONIBILIDADE / SEO (polimorfico)
// ============================================================

// Hardening (2026-07): `providerKey` PERMANECE opcional de proposito — o worker
// usa `providerKey = null` como sinal legitimo de "provedor nao identificado
// pela API" (missing-provider); NUNCA e derivado do provider_name.
//
// IDENTIDADE vs PAYLOAD (duas funcoes SQL versionadas, SHA-256; ver ADR 0002):
//  - `watch_offer_identity_key_v1(...)` = IDENTIDADE ESTAVEL da oferta (indice
//    unico funcional). So o que identifica o MESMO objeto: entidade, pais,
//    modalidade, provider_api, e external_offer_id (prioritario) OU provider
//    tecnico (provider_key; fallback provider_name normalizado so quando null) +
//    package. NAO inclui preco/URLs/validade.
//  - `watch_offer_payload_fingerprint_v1(...)` = tudo que, ao mudar, exige nova
//    revisao (identidade + provider_name + package + quality + preco/moeda +
//    URLs + validade + licenca/atribuicao). `approved_payload_hash` guarda ESTE
//    fingerprint. Trigger permanente `watch_availability_display_guard` torna
//    IMPOSSIVEL `display_allowed=true` sem hash=fingerprint + reviewed_at/by +
//    licenca permitida + atribuicao/linkback (fail-closed no banco).
model WatchAvailability {
  id                  BigInt        @id @default(autoincrement())
  entityType          EntityType    @map("entity_type")
  entityId            BigInt        @map("entity_id")
  countryCode         String        @map("country_code")
  externalOfferId     String?       @map("external_offer_id") // ID ESTAVEL da oferta na API de origem (identidade prioritaria); null quando a API nao fornece
  providerKey         String?       @map("provider_key") // identificador TECNICO da API/tabela canonica; null = provedor nao identificado (missing-provider). NUNCA derivado do provider_name
  providerName        String        @map("provider_name") // nome de EXIBICAO (pode mudar/traduzir); nao e identidade tecnica
  offerType           OfferType     @map("offer_type") // so modalidades LEGAIS (inv. 10)
  deepLink            String?       @map("deep_link") // destino legal; nunca torrent/IPTV/player pirata
  price               Decimal?
  currency            String?       @db.Char(3) // CHECK (price IS NULL OR currency IS NOT NULL) via SQL
  quality             String?
  availableFrom       DateTime?     @map("available_from")
  availableUntil      DateTime?     @map("available_until")
  fetchedAt           DateTime?     @map("fetched_at")
  staleAfter          DateTime?     @map("stale_after")
  providerApi         String?       @map("provider_api")
  licenseStatus       LicenseStatus @default(unknown) @map("license_status") // default seguro (inv. 6)
  displayAllowed      Boolean       @default(false) @map("display_allowed") // default seguro (inv. 6)
  requiresAttribution Boolean       @default(true) @map("requires_attribution")
  requiresLinkback    Boolean       @default(true) @map("requires_linkback")
  attributionText     String?       @map("attribution_text")
  attributionUrl      String?       @map("attribution_url")
  reviewedAt          DateTime?     @map("reviewed_at") // data da revisao humana
  reviewedBy          String?       @map("reviewed_by") // identidade do revisor humano
  approvedPayloadHash String?       @map("approved_payload_hash") // hash/fingerprint do payload aprovado na revisao
  webUrl              String?       @map("web_url") // link web (navegador); distinto de deep_link (app)
  package             String?       @map("package") // pacote/bundle da oferta (add-on/channel)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // --- Backend B ---
  // Provedor CANONICO resolvido via WatchProviderAlias(providerApi, providerKey).
  // Nullable de proposito: uma oferta sem alias mapeado continua sendo ingerida
  // e auditada — so nao pode ser exibida (o display guard exige este campo E
  // reconfere o alias a cada escrita). NAO entra no fingerprint de payload v1:
  // e campo DERIVADO da nossa tabela de aliases, nao do payload do upstream.
  watchProviderId     BigInt? @map("watch_provider_id")
  dataUsageDecisionId BigInt? @map("data_usage_decision_id")

  country           Country            @relation(fields: [countryCode], references: [code])
  watchProvider     WatchProvider?     @relation(fields: [watchProviderId], references: [id])
  dataUsageDecision DataUsageDecision? @relation(fields: [dataUsageDecisionId], references: [id])
  // provider_api passa a ser FK real: uma oferta de fornecedor fantasma nunca
  // poderia ser auditada.
  api               ApiProvider?       @relation(fields: [providerApi], references: [key])

  // Identidade da oferta = fingerprint canonico versionado `watch_offer_fingerprint(...)`
  // (external_offer_id quando presente; senao a tupla completa: provider tecnico,
  // modalidade, package, qualidade, preco/moeda, URLs, validade). Indice unico
  // sobre esse fingerprint (SQL bruto) — ofertas legitimamente distintas NUNCA
  // colapsam. Ver ADR 0002.
  @@index([entityType, entityId, countryCode])
  @@index([countryCode])
  @@index([providerKey])
  @@index([externalOfferId])
  @@index([watchProviderId])
  @@index([dataUsageDecisionId])
  @@map("watch_availability")
}

// Hardening (2026-07): historico preservado (nunca UPDATE destrutivo em linha
// antiga) — cada reavaliacao INSERE uma nova linha. `isCurrent` identifica de
// forma inequivoca a decisao VIGENTE por (entity_type, entity_id,
// language_code); um indice unico PARCIAL (WHERE is_current = true, SQL
// bruto) impede duas decisoes concorrentes marcadas como atuais. `policyVersion`
// e `decisionOrigin` registram QUAL versao de politica/motor gerou a decisao;
// `decidedBy` registra revisao humana quando aplicavel.
// Prompt 10: a decisao de indexabilidade de ARTIGO editorial mora NESTA MESMA
// tabela (proibido criar uma segunda tabela de indexabilidade). Mesmo padrao do
// `search_documents`: discriminador `docKind` + `articleId`, com CHECK de forma
// e unique parcial de decisao vigente POR KIND (SQL bruto na migration).
model PageIndexabilityDecision {
  id               BigInt        @id @default(autoincrement())
  docKind          PublicDocKind @default(entity) @map("doc_kind")
  entityType       EntityType?   @map("entity_type")
  entityId         BigInt?       @map("entity_id")
  articleId        BigInt?       @map("article_id")
  languageCode     String        @map("language_code")
  url              String
  decision         IndexDecision @default(noindex) // default seguro (inv. 5)
  reason           String?
  isCurrent        Boolean       @default(true) @map("is_current") // decisao vigente (unique parcial via SQL bruto)
  supersedesId     BigInt?       @map("supersedes_id") // aponta para a decisao anterior que esta substitui
  policyVersion    String?       @map("policy_version") // versao da politica/motor de indexabilidade
  decisionOrigin   String?       @map("decision_origin") // ex.: "sync_worker", "seo_policy_engine", "human_override"
  decidedBy        String?       @map("decided_by") // identidade humana quando a decisao foi revisada/override
  valueBlocksCount Int           @default(0) @map("value_blocks_count")
  hasUniqueIntro   Boolean       @default(false) @map("has_unique_intro")
  hasWatchData     Boolean       @default(false) @map("has_watch_data")
  hasRatings       Boolean       @default(false) @map("has_ratings")
  hasNews          Boolean       @default(false) @map("has_news")
  hasReview        Boolean       @default(false) @map("has_review")
  hasFaq           Boolean       @default(false) @map("has_faq")
  hasTrailer       Boolean       @default(false) @map("has_trailer")
  thinContentScore Float?        @map("thin_content_score")
  decidedAt        DateTime?     @map("decided_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  language     Language                   @relation(fields: [languageCode], references: [code])
  supersedes   PageIndexabilityDecision?  @relation("PageIndexabilityDecisionHistory", fields: [supersedesId], references: [id])
  supersededBy PageIndexabilityDecision[] @relation("PageIndexabilityDecisionHistory")
  article      Article?                   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, languageCode])
  @@index([entityType, entityId, languageCode])
  @@index([decision])
  @@index([languageCode])
  @@index([isCurrent])
  @@map("page_indexability_decisions")
}

// ============================================================
// INFRA / INGESTAO
// ============================================================

model ApiCache {
  id          BigInt    @id @default(autoincrement())
  providerApi String    @map("provider_api")
  endpoint    String
  requestKey  String    @map("request_key")
  paramsHash  String    @map("params_hash")
  payload     Json
  payloadHash String    @map("payload_hash")
  fetchedAt   DateTime  @default(now()) @map("fetched_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  provider ApiProvider @relation(fields: [providerApi], references: [key])

  @@unique([providerApi, requestKey, paramsHash])
  @@index([expiresAt])
  @@map("api_cache")
}

model ApiSyncLog {
  id             BigInt     @id @default(autoincrement())
  providerApi    String     @map("provider_api")
  endpoint       String
  status         SyncStatus
  errorCode      String?    @map("error_code")
  itemsProcessed Int        @default(0) @map("items_processed")
  itemsCreated   Int        @default(0) @map("items_created")
  itemsUpdated   Int        @default(0) @map("items_updated")
  durationMs     Int?       @map("duration_ms")
  quotaCost      Int?       @map("quota_cost")
  payloadHash    String?    @map("payload_hash")
  createdAt      DateTime   @default(now()) @map("created_at")

  provider ApiProvider @relation(fields: [providerApi], references: [key])

  @@index([providerApi])
  @@index([createdAt])
  @@map("api_sync_logs")
}

// --- Raw sync TMDB (P0-00a): arquivo permanente de payload BRUTO ---
// So JSON cru (base + append/translations); nenhum arquivo/imagem baixado.
// Worker-only, como ApiCache; o render nao le esta tabela neste ciclo.
model TmdbRaw {
  id           BigInt         @id @default(autoincrement())
  entityType   TmdbEntityKind @map("entity_type")
  tmdbId       Int            @map("tmdb_id")
  baseLanguage String         @map("base_language")
  payload      Json
  payloadHash  String         @map("payload_hash")
  etag         String?
  lastModified String?        @map("last_modified")
  fetchedAt    DateTime       @default(now()) @map("fetched_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([entityType, tmdbId, baseLanguage])
  @@index([payloadHash])
  @@index([fetchedAt])
  @@map("tmdb_raw")
}

// --- Raw sync TMDB (P0-00a): cache de UMA linha do /configuration (imagens) ---
// Singleton por provider (PK natural provider_api = "tmdb"). Sem FK a
// ApiProvider de proposito (evita alterar modelo existente).
model TmdbImageConfig {
  providerApi   String   @id @map("provider_api")
  baseUrl       String   @map("base_url")
  secureBaseUrl String   @map("secure_base_url")
  posterSizes   Json     @map("poster_sizes")
  backdropSizes Json     @map("backdrop_sizes")
  stillSizes    Json     @map("still_sizes")
  profileSizes  Json     @map("profile_sizes")
  logoSizes     Json     @map("logo_sizes")
  changeKeys    Json?    @map("change_keys")
  etag          String?
  lastModified  String?  @map("last_modified")
  fetchedAt     DateTime @default(now()) @map("fetched_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("tmdb_image_config")
}

// --- Catalogo TMDB (Fase 6): generos normalizados ---
// Lista canonica de generos por media_type (movie|tv), normalizada de
// /genre/{movie,tv}/list pelo worker de taxonomia. Worker-only.
model Genre {
  tmdbId    Int      @map("tmdb_id")
  mediaType String   @map("media_type") // 'movie' | 'tv'
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movies   MovieGenre[]
  tvShows  TvShowGenre[]

  @@id([mediaType, tmdbId])
  @@map("genres")
}

// --- Recomendacoes do TMDB (Fase 10) ---
// `recommendations` e `similar` estao no append de filme E de serie desde
// sempre (ver MOVIE_APPEND/TV_APPEND em api-clients/tmdb). Chegavam em toda
// requisicao de detalhe e eram DESCARTADOS no normalizador — terceiro caso do
// mesmo padrao, depois de `watch/providers` (PR #181) e da biografia de pessoa.
//
// POR TMDB_ID, NAO POR FK LOCAL. Uma recomendacao aponta para o universo do
// TMDB, nao para o nosso catalogo: a maioria dos alvos ainda nao foi ingerida.
// Guardar FK local obrigaria a descartar na ESCRITA o que ainda nao temos — e
// perder o vinculo para sempre quando o titulo entrasse depois. A leitura
// resolve por `tmdb_id` e ignora quem nao existe.
//
// `kind` separa os dois sinais em vez de mistura-los: `recommendations` e
// comportamental (quem viu isto viu aquilo) e `similar` e por metadado. Sao
// qualidades diferentes, e a leitura prefere o primeiro.
model TitleRecommendation {
  sourceMediaType String   @map("source_media_type") // 'movie' | 'tv'
  sourceTmdbId    Int      @map("source_tmdb_id")
  kind            String // 'recommendation' | 'similar'
  targetMediaType String   @map("target_media_type") // 'movie' | 'tv'
  targetTmdbId    Int      @map("target_tmdb_id")
  position        Int
  createdAt       DateTime @default(now()) @map("created_at")

  @@id([sourceMediaType, sourceTmdbId, kind, targetTmdbId])
  @@index([sourceMediaType, sourceTmdbId, kind, position])
  @@index([targetMediaType, targetTmdbId])
  @@map("title_recommendations")
}

// --- Vinculo titulo <-> genero (Fase 10) ---
// `genres` existia como DICIONARIO desde a Fase 6 e NAO tinha ligacao com
// titulo nenhum: o `genres[]` do detalhe do TMDB chegava no payload e era
// descartado por `normalizeMovie`/`normalizeTv`, exatamente como a biografia de
// pessoa e como `watch/providers` antes da PR #181.
//
// Ordem PRESERVADA (`position`): o TMDB devolve os generos em ordem de
// relevancia editorial, e o chip do hero mostra os primeiros. Reordenar por id
// ou por nome trocaria "Ficcao cientifica" por "Acao" na vitrine sem que
// ninguem tivesse decidido isso.
//
// `mediaType` e coluna propria por causa da PK composta de `genres`. Um CHECK na
// migration prende o valor a 'movie'/'tv' conforme a tabela, para que a FK nao
// possa apontar um filme para um genero de serie.
model MovieGenre {
  movieId        BigInt   @map("movie_id")
  genreMediaType String   @default("movie") @map("genre_media_type")
  genreTmdbId    Int      @map("genre_tmdb_id")
  position       Int
  createdAt      DateTime @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreMediaType, genreTmdbId], references: [mediaType, tmdbId], onDelete: Cascade)

  @@id([movieId, genreTmdbId])
  @@index([genreMediaType, genreTmdbId])
  @@map("movie_genres")
}

model TvShowGenre {
  tvShowId       BigInt   @map("tv_show_id")
  genreMediaType String   @default("tv") @map("genre_media_type")
  genreTmdbId    Int      @map("genre_tmdb_id")
  position       Int
  createdAt      DateTime @default(now()) @map("created_at")

  tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreMediaType, genreTmdbId], references: [mediaType, tmdbId], onDelete: Cascade)

  @@id([tvShowId, genreTmdbId])
  @@index([genreMediaType, genreTmdbId])
  @@map("tv_show_genres")
}

// ============================================================
// PAIS DE ORIGEM DO TITULO (ficha tecnica, 20/08/2026)
// ============================================================
//
// `production_countries` (filme) e `origin_country` (serie) chegavam no DETALHE
// do TMDB e eram descartados — mesma familia de `watch/providers` (#181),
// biografia (#190) e `recommendations` (#191). O codigo ISO fica SEM FK para
// `countries` DE PROPOSITO: aquela tabela e o ESCOPO de exibicao de ofertas
// (~13 codigos) e nao um dicionario ISO — uma FK recusaria "NZ" de um titulo
// neozelandes (a licao das 100/100 falhas do watch). A grafia e travada por
// CHECK na migration; o render resolve o nome pt via `countries` quando o
// codigo estiver la, senao mostra o proprio codigo (fato, nunca fabricacao).

model MovieProductionCountry {
  movieId     BigInt   @map("movie_id")
  countryCode String   @map("country_code") // ISO 3166-1 alpha-2 (CHECK na migration)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([movieId, countryCode])
  @@index([countryCode])
  @@map("movie_production_countries")
}

model TvShowOriginCountry {
  tvShowId    BigInt   @map("tv_show_id")
  countryCode String   @map("country_code") // ISO 3166-1 alpha-2 (CHECK na migration)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  tvShow TvShow @relation(fields: [tvShowId], references: [id], onDelete: Cascade)

  @@id([tvShowId, countryCode])
  @@index([countryCode])
  @@map("tv_show_origin_countries")
}

// --- Mídia TMDB (Fase 7): metadados de imagens ---
// So METADADOS (nenhum binario baixado). Nasce display_allowed=false +
// license_status=unknown (invariante 6): exibicao exige decisao humana. Worker-only.
model TmdbImage {
  id             BigInt         @id @default(autoincrement())
  providerApi    String         @default("tmdb") @map("provider_api")
  entityType     TmdbEntityKind @map("entity_type")
  tmdbId         Int            @map("tmdb_id")
  imageType      String         @map("image_type") // poster|backdrop|logo|profile|still
  filePath       String         @map("file_path")
  languageCode   String?        @map("language_code") // iso_639_1 (pode ser null)
  width          Int?
  height         Int?
  aspectRatio    Float?         @map("aspect_ratio")
  voteAverage    Float?         @map("vote_average")
  voteCount      Int?           @map("vote_count")
  payloadHash    String         @map("payload_hash")
  licenseStatus  LicenseStatus  @default(unknown) @map("license_status")
  displayAllowed Boolean        @default(false) @map("display_allowed")
  fetchedAt      DateTime       @default(now()) @map("fetched_at")
  staleAfter     DateTime?      @map("stale_after")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([entityType, tmdbId, imageType, filePath])
  @@index([entityType, tmdbId])
  @@map("tmdb_images")
}

// --- Mídia TMDB (Fase 7): metadados de videos ---
// So metadados (link/site/key, nunca embed pirata). Nasce display_allowed=false.
model TmdbVideo {
  id             BigInt         @id @default(autoincrement())
  providerApi    String         @default("tmdb") @map("provider_api")
  entityType     TmdbEntityKind @map("entity_type")
  tmdbId         Int            @map("tmdb_id")
  tmdbVideoId    String         @map("tmdb_video_id")
  site           String
  videoKey       String         @map("video_key")
  name           String?
  videoType      String?        @map("video_type") // Trailer|Teaser|Clip|...
  official       Boolean?
  languageCode   String?        @map("language_code")
  countryCode    String?        @map("country_code")
  size           Int?
  publishedAt    DateTime?      @map("published_at")
  payloadHash    String         @map("payload_hash")
  licenseStatus  LicenseStatus  @default(unknown) @map("license_status")
  displayAllowed Boolean        @default(false) @map("display_allowed")
  fetchedAt      DateTime       @default(now()) @map("fetched_at")
  staleAfter     DateTime?      @map("stale_after")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@unique([entityType, tmdbId, tmdbVideoId])
  @@index([entityType, tmdbId])
  @@map("tmdb_videos")
}

// --- Sync incremental TMDB (Fase 8): checkpoint/resume de paginacao ---
// Persiste a ultima pagina/cursor por job para retomada; worker-only.
model TmdbSyncCheckpoint {
  id          BigInt   @id @default(autoincrement())
  providerApi String   @default("tmdb") @map("provider_api")
  job         String // ex.: 'list:movie/popular', 'discover:movie', 'changes:movie'
  paramsHash  String   @map("params_hash")
  lastPage    Int      @default(0) @map("last_page")
  totalPages  Int?     @map("total_pages")
  done        Boolean  @default(false)
  cursor      String? // janela/token de changes
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([job, paramsHash])
  @@map("tmdb_sync_checkpoint")
}

// ============================================================
// CATALOGO EM ESCALA (Backend A): fila duravel + busca PostgreSQL
// ============================================================
// Primitivos NOVOS do catalogo em escala. Ambos sao worker/infra e NAO sao
// lidos no caminho de render de pagina indexavel (o render le somente as
// tabelas normalizadas + cache). Tabelas AUTOCONTIDAS: nenhuma FK composta
// para `entities` (mantem a migration aditiva e segura no cenario de upgrade,
// como genres/tmdb_images).

// Fila duravel de jobs do catalogo. Generaliza o padrao provado do
// EntityWriterJob (claim com FOR UPDATE SKIP LOCKED, unique parcial de job
// ativo) para a ingestao/normalizacao. `idempotencyKey` deduplica enfileiramento
// (repetir a mesma chave e noop); `attempts`/`maxAttempts` + `retry_wait`/
// `dead_letter` modelam retry com backoff e dead-letter; `heartbeatAt` habilita
// reclaim de jobs orfaos (worker morto). `entityType` usa TmdbEntityKind
// (superset: cobre collection/network/company/keyword, nao so o renderavel).
model CatalogJob {
  id             BigInt           @id @default(autoincrement())
  jobType        CatalogJobType   @map("job_type")
  status         CatalogJobStatus @default(pending)
  entityType     TmdbEntityKind?  @map("entity_type") // alvo do job (opcional: bootstrap/discover nao tem alvo unico)
  externalId     String?          @map("external_id") // id externo (ex.: tmdb_id como texto); a entidade pode ainda nao estar promovida
  payload        Json             @default("{}") // parametros do job (janela de changes, pagina, etc.)
  idempotencyKey String           @unique @map("idempotency_key") // dedupe de enfileiramento (repetir = noop)
  attempts       Int              @default(0)
  maxAttempts    Int              @default(5) @map("max_attempts")
  priority       Int              @default(100) // MENOR = mais prioritario (ORDER BY priority ASC)
  availableAt    DateTime         @default(now()) @map("available_at") // elegivel para claim quando now >= available_at (backoff adia)
  claimedAt      DateTime?        @map("claimed_at")
  heartbeatAt    DateTime?        @map("heartbeat_at") // ultimo sinal de vida do worker (reclaim de orfaos)
  completedAt    DateTime?        @map("completed_at")
  lastErrorCode  String?          @map("last_error_code") // codigo curto e seguro (sem PII/segredo)
  lastErrorSafe  String?          @map("last_error_safe") // mensagem redigida/segura para log
  runId          String?          @map("run_id") // correlacao request/run para logs estruturados
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  // Ordem de claim: WHERE status IN (pending, retry_wait) AND available_at <= now
  // ORDER BY priority ASC, available_at ASC (indice composto abaixo).
  @@index([status, priority, availableAt])
  @@index([entityType, externalId])
  @@index([heartbeatAt])
  @@map("catalog_jobs")
}

// Projecao denormalizada para busca PostgreSQL (unaccent + pg_trgm). Uma linha
// por (entity_type, entity_id, locale). `normalizedText` guarda o texto ja
// dobrado (sem acento, minusculo) para casar com o termo de busca dobrado do
// mesmo jeito — casamento acento-insensivel deterministico. Indices GIN trgm +
// a funcao IMMUTABLE `immutable_unaccent` vivem na migration (SQL bruto).
// So entidades RENDERAVEIS entram (movie/tv/person) — resultados linkam paginas
// publicas; nunca dado sem licenca/slug.
// Prompt 10: artigos editoriais entram NESTA MESMA projecao (proibido criar um
// segundo search engine). Como `EntityType` nao pode ganhar `article`, o
// discriminador `docKind` + `articleId` convive com (entityType, entityId):
// `entity` => entityType/entityId preenchidos e articleId NULL;
// `article`  => articleId preenchido e entityType/entityId NULL.
// CHECK de forma + uniques PARCIAIS por kind vivem na migration (SQL bruto).
model SearchDocument {
  id                BigInt        @id @default(autoincrement())
  docKind           PublicDocKind @default(entity) @map("doc_kind")
  entityType        EntityType?   @map("entity_type") // renderavel: movie | tv | person
  entityId          BigInt?       @map("entity_id")
  articleId         BigInt?       @map("article_id")
  locale            String // BCP-47 (pt-BR); segue PUBLISHED_LOCALES
  primaryText       String        @map("primary_text") // titulo canonico/nome
  alternativeText   String        @default("") @map("alternative_text") // titulos alternativos/aliases (exibicao, ' | ')
  normalizedText    String        @map("normalized_text") // fold(primaryText + aliases): sem acento + minusculo (casamento base)
  normalizedAliases String        @default("") @map("normalized_aliases") // aliases dobrados, '|'-delimitados (casamento exato de alias)
  subtitle          String? // linha de apoio (ano/tipo) para o resultado
  year              Int?
  popularity        Decimal? // desempate de ranking (sinal TMDB tecnico, nunca nota editorial)
  imagePath         String?       @map("image_path") // file_path cru; URL montada no render por buildTmdbImageUrl
  canonicalUrl      String?       @map("canonical_url")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // O unique de ENTIDADE continua sendo este (nao mudou de nome nem de forma).
  // Ele segue travando entidades mesmo com as colunas agora anulaveis: linhas
  // de artigo tem (NULL, NULL, locale) e NULL nunca colide em unique no
  // PostgreSQL — ou seja, este indice simplesmente as ignora.
  //
  // Por isso mesmo ele NAO trava artigo: o unique PARCIAL
  // `search_documents_article_unique` (article_id, locale) WHERE
  // doc_kind='article' existe na migration para esse papel. Sem ele, o mesmo
  // artigo poderia ganhar N documentos no mesmo locale (duplicata de busca).
  @@unique([entityType, entityId, locale])
  @@index([locale])
  @@index([articleId])
  @@map("search_documents")
}

// --- Descoberta persistida (Backend A): snapshots de listas ---
// Uma captura imutavel de uma lista de descoberta (trending/popular/top_rated/
// upcoming/now_playing/airing_today/on_the_air/discover). O render NUNCA chama o
// TMDB: le o ultimo snapshot VALIDO (capturedAt/expiresAt). `payloadHash` permite
// pular reescrita quando a lista nao mudou.
model DiscoverySnapshot {
  id          BigInt     @id @default(autoincrement())
  listType    String     @map("list_type") // trending|popular|top_rated|upcoming|now_playing|airing_today|on_the_air|discover
  entityType  EntityType @map("entity_type") // movie | tv
  locale      String
  country     String?
  window      String? // janela do trending (day|week) ou rotulo do discover
  capturedAt  DateTime   @default(now()) @map("captured_at")
  expiresAt   DateTime   @map("expires_at")
  provider    String     @default("tmdb")
  payloadHash String     @map("payload_hash")
  createdAt   DateTime   @default(now()) @map("created_at")

  items DiscoverySnapshotItem[]

  @@index([listType, entityType, locale, capturedAt])
  @@index([expiresAt])
  @@map("discovery_snapshots")
}

model DiscoverySnapshotItem {
  id            BigInt   @id @default(autoincrement())
  snapshotId    BigInt   @map("snapshot_id")
  entityId      BigInt   @map("entity_id") // id interno da entidade promovida
  position      Int
  providerScore Decimal? @map("provider_score") // popularity/vote do provider (tecnico, nunca nota editorial)
  createdAt     DateTime @default(now()) @map("created_at")

  snapshot DiscoverySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, entityId])
  @@unique([snapshotId, position])
  @@index([entityId])
  @@map("discovery_snapshot_items")
}

// ============================================================
// CATALOGO TMDB — ENTIDADES DE REFERENCIA (Backend A)
// ============================================================
// Colecoes, produtoras, redes, keywords e titulos alternativos. Relacoes centrais
// como TABELAS (nunca JSON solto). Worker-only na escrita; o render le via stores.
// Refs polimorficas (entity_keywords, entity_alternative_titles) ganham FK composta
// para `entities` via DO-block CONDICIONAL na migration (ver ADR 0012).

model Collection {
  id           BigInt    @id @default(autoincrement())
  tmdbId       Int       @unique @map("tmdb_id")
  name         String
  overview     String?
  posterPath   String?   @map("poster_path")
  backdropPath String?   @map("backdrop_path")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSyncedAt DateTime? @map("last_synced_at")

  movies MovieCollectionMembership[]

  @@map("collections")
}

model MovieCollectionMembership {
  id           BigInt   @id @default(autoincrement())
  collectionId BigInt   @map("collection_id")
  movieId      BigInt   @map("movie_id")
  position     Int?
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([collectionId, movieId])
  @@index([movieId])
  @@map("movie_collection_memberships")
}

model ProductionCompany {
  id            BigInt    @id @default(autoincrement())
  tmdbId        Int       @unique @map("tmdb_id")
  name          String
  logoPath      String?   @map("logo_path")
  originCountry String?   @map("origin_country")
  headquarters  String?
  homepage      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastSyncedAt  DateTime? @map("last_synced_at")

  movies  MovieProductionCompany[]
  tvShows TvProductionCompany[]

  @@map("production_companies")
}

model MovieProductionCompany {
  movieId   BigInt   @map("movie_id")
  companyId BigInt   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  movie   Movie             @relation(fields: [movieId], references: [id], onDelete: Cascade)
  company ProductionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([movieId, companyId])
  @@index([companyId])
  @@map("movie_production_companies")
}

model TvProductionCompany {
  tvShowId  BigInt   @map("tv_show_id")
  companyId BigInt   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  tvShow  TvShow            @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  company ProductionCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([tvShowId, companyId])
  @@index([companyId])
  @@map("tv_production_companies")
}

model Network {
  id            BigInt    @id @default(autoincrement())
  tmdbId        Int       @unique @map("tmdb_id")
  name          String
  logoPath      String?   @map("logo_path")
  originCountry String?   @map("origin_country")
  headquarters  String?
  homepage      String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastSyncedAt  DateTime? @map("last_synced_at")

  tvShows TvNetwork[]

  @@map("networks")
}

model TvNetwork {
  tvShowId  BigInt   @map("tv_show_id")
  networkId BigInt   @map("network_id")
  createdAt DateTime @default(now()) @map("created_at")

  tvShow  TvShow  @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  network Network @relation(fields: [networkId], references: [id], onDelete: Cascade)

  @@id([tvShowId, networkId])
  @@index([networkId])
  @@map("tv_networks")
}

model Keyword {
  id        BigInt   @id @default(autoincrement())
  tmdbId    Int      @unique @map("tmdb_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  entities EntityKeyword[]

  @@map("keywords")
}

model EntityKeyword {
  id         BigInt     @id @default(autoincrement())
  keywordId  BigInt     @map("keyword_id")
  entityType EntityType @map("entity_type") // movie | tv
  entityId   BigInt     @map("entity_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@unique([keywordId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_keywords")
}

// Titulos alternativos por pais (TMDB alternative_titles). `normalized` guarda a
// dobra (sem acento/minusculo) — alimenta o alias exato da busca.
model EntityAlternativeTitle {
  id          BigInt     @id @default(autoincrement())
  entityType  EntityType @map("entity_type") // movie | tv
  entityId    BigInt     @map("entity_id")
  countryCode String?    @map("country_code")
  title       String
  normalized  String
  type        String?
  source      String     @default("tmdb")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([entityType, entityId, title, countryCode])
  @@index([entityType, entityId])
  @@index([normalized])
  @@map("entity_alternative_titles")
}

// ============================================================
// NOTICIAS / BLOG (editorial) — Fase 4F-A (schema base)
// ============================================================
// Base minima do ambiente editorial/blog. Segue as convencoes do schema:
//  - fatos independentes de idioma em `articles`; texto por idioma em
//    `article_translations` (slug proprio por idioma; artigos NAO usam a tabela
//    `slugs`, e `EntityType` NAO ganha valor `article` nesta fase);
//  - governanca de licenca/atribuicao no `articles` (invariante 6): so publica
//    com `display_allowed`; `source_name`/`source_url` creditam a fonte externa;
//  - `ai_assisted` habilita o disclaimer de IA do design;
//  - pt-BR publica primeiro: `review_status`/`index_status` nascem draft/noindex
//    (en/es idem) ate revisao humana (invariantes 7/9);
//  - `entity_news_links` liga artigo a filme/serie/pessoa pela ref polimorfica
//    (entity_type + entity_id), com FK composta para `entities` (D1 evoluido),
//    como cast_members/crew_members.

model Article {
  id                  BigInt        @id @default(autoincrement())
  category            String? // v2: FK ArticleCategory
  authorName          String?       @map("author_name") // v2: FK Author
  heroImagePath       String?       @map("hero_image_path") // local-only no render
  publishedAt         DateTime?     @map("published_at")
  readTimeMinutes     Int?          @map("read_time_minutes")
  aiAssisted          Boolean       @default(false) @map("ai_assisted") // habilita disclaimer de IA
  sourceName          String?       @map("source_name") // fonte externa creditada (ex.: Collider)
  sourceUrl           String?       @map("source_url")
  licenseStatus       LicenseStatus @default(unknown) @map("license_status") // default seguro (inv. 6)
  displayAllowed      Boolean       @default(false) @map("display_allowed") // gate-mestra de exibicao
  requiresAttribution Boolean       @default(false) @map("requires_attribution")
  requiresLinkback    Boolean       @default(false) @map("requires_linkback")
  // Ancora do documento no CMS editorial (Payload). E o que permite reprojetar
  // o MESMO artigo depois de uma edicao sem depender do slug — slug muda, id
  // do Payload nao. UNICO: dois artigos publicos nunca apontam para o mesmo
  // documento de origem.
  payloadDocumentId   String?       @unique @map("payload_document_id")
  /// Asset de capa GOVERNADO (projetado do CMS). `heroImagePath` continua sendo
  /// o caminho lido pelo render; este vinculo preserva credito, licenca e
  /// dimensoes, que um caminho de string sozinho perderia.
  heroMediaAssetId    BigInt?       @map("hero_media_asset_id")
  // Maior sequencia de EMISSAO ja projetada para este artigo (o id serial da
  // linha na outbox do CMS, que e a ordem real em que os eventos nasceram).
  // E a trava contra evento FORA DE ORDEM: um retry antigo chegando depois de
  // uma edicao nova nao pode reescrever o estado mais recente por cima.
  //
  // Deliberadamente NAO e o `aggregateVersion` da outbox: aquele campo guarda
  // um HASH do conteudo publicado, nao um contador — nao ordena nada.
  projectedSequence   Int?          @map("projected_sequence")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  translations         ArticleTranslation[]
  entityLinks          EntityNewsLink[]
  sourceLinks          ArticleSourceLink[]
  projectionReceipts   EditorialProjectionReceipt[]
  heroMediaAsset       EditorialMediaAsset?         @relation("ArticleHeroMedia", fields: [heroMediaAssetId], references: [id], onDelete: SetNull)
  searchDocuments      SearchDocument[]
  indexabilityDecision PageIndexabilityDecision[]

  // CHECK (category IS NULL OR category <> '') e (author_name IS NULL OR
  // author_name <> '') via SQL bruto (mesma convencao de imdb_id_not_empty).
  @@index([publishedAt])
  @@index([licenseStatus])
  @@index([category])
  @@index([heroMediaAssetId])
  @@map("articles")
}

model ArticleTranslation {
  id                BigInt        @id @default(autoincrement())
  articleId         BigInt        @map("article_id")
  languageCode      String        @map("language_code")
  slug              String // slug proprio por idioma (unico por idioma)
  title             String
  deck              String? // subtitulo/excerpt editorial
  body              String? // corpo proprio (nunca copiado); ausencia -> pagina fina
  metaTitle         String?       @map("meta_title")
  metaDescription   String?       @map("meta_description")
  reviewStatus      ReviewStatus  @default(draft) @map("review_status") // nasce draft (inv. 7/9)
  indexStatus       IndexDecision @default(noindex) @map("index_status") // nasce noindex
  // `publishedAt` no FUTURO = materia agendada: NAO vaza para nenhuma
  // superficie publica (listagem, artigo, relacionadas, sitemap, busca).
  // O gate esta em `isPublishableArticle` (apps/web/src/lib/news-presenter.ts).
  publishedAt       DateTime?     @map("published_at")
  // Correcao MATERIAL (distinta de atualizacao editorial normal): quando um
  // fato publicado e corrigido, a evidencia fica registrada e visivel. Nunca
  // apagar silenciosamente. CHECK: correctionNote exige correctedAt e
  // vice-versa (SQL bruto).
  correctedAt       DateTime?     @map("corrected_at")
  correctionNote    String?       @map("correction_note")
  // Corpo ESTRUTURADO (blocos do contrato editorial). `body` continua sendo a
  // representacao em texto — nenhuma superficie existente muda de fonte por
  // causa desta coluna. Os blocos sao aditivos: quem sabe renderiza-los usa,
  // quem nao sabe continua com `body`.
  bodyBlocks        Json?         @map("body_blocks")
  // Versao do CONTEUDO (hash do corpo publicado no CMS), nao do schema. Serve
  // para detectar reprojecao sem mudanca e evitar reescrita inutil.
  bodyBlocksVersion String?       @map("body_blocks_version")

  // --- SEO APROVADO pelo CMS (projetado; nunca sugestao crua do pipeline) ---
  //
  // Aditivo por construcao: nenhuma superficie existente muda de fonte por
  // causa destas colunas. Quem sabe usa-las usa; quem nao sabe continua com
  // `metaTitle`/`metaDescription`.
  //
  // O que NAO esta aqui e deliberado: `canonical`, `robots` e o JSON-LD final
  // pertencem ao lado publico e sao DERIVADOS de `slugs`/`redirects` e da
  // decisao de indexabilidade. Projetar canonical do CMS deixaria duas fontes
  // discordando sobre a mesma URL.
  socialTitle              String?  @map("social_title")
  socialDescription        String?  @map("social_description")
  // Excecao EDITORIAL explicita (sindicacao, conteudo espelhado). Nao e a
  // canonical de uso normal, que continua derivada de `slugs`.
  canonicalOverride        String?  @map("canonical_override")
  focusKeyphrase           String?  @map("focus_keyphrase")
  relatedKeyphrases        String[] @default([]) @map("related_keyphrases")
  editorialKeywords        String[] @default([]) @map("editorial_keywords")
  // RECOMENDACAO de tipo de JSON-LD. O render pode recusa-la: emitir `Review`
  // sem review propria seria schema falso, e essa decisao e do lado publico.
  schemaTypeRecommendation String?  @map("schema_type_recommendation")
  articleSection           String?  @map("article_section")
  // `alt` APROVADO por midia e links internos APROVADOS. Json porque sao listas
  // pequenas, lidas inteiras e nunca consultadas por campo.
  approvedImageAlt         Json?    @map("approved_image_alt")
  approvedInternalLinks    Json?    @map("approved_internal_links")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageCode], references: [code])

  // Hardening (2026-07): investigado se review_status/index_status/published_at
  // deveriam ganhar CHECK de coerencia (gap #5 da auditoria). NAO adicionado:
  // apps/admin/src/lib/editorial-action-policy.ts + editorial-actions.ts
  // tratam esses 3 campos como decisoes editoriais INDEPENDENTES por design
  // (indexStatus/reviewStatus podem ser setados para qualquer valor do enum
  // isoladamente; publishedAt nunca e tocado pela acao e sobrevive a reversao
  // para draft). Um CHECK acoplando os 3 quebraria esse fluxo real existente.
  @@unique([articleId, languageCode])
  @@unique([languageCode, slug])
  @@index([languageCode, indexStatus])
  @@map("article_translations")
}

model EntityNewsLink {
  id         BigInt     @id @default(autoincrement())
  articleId  BigInt     @map("article_id")
  entityType EntityType @map("entity_type") // movie | tv | person (ref polimorfica -> entities, FK via SQL bruto)
  entityId   BigInt     @map("entity_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([articleId])
  @@map("entity_news_links")
}

// ============================================================
// USER PRODUCT PLATFORM (Backend C) — usuarios, auth, tracking,
// listas, ratings, reviews, historico, recomendacoes, LGPD.
//
// Decisoes de produto registradas ANTES desta secao em
// docs/product/user-product-decisions.md (pre-requisito da migration).
// ADR: docs/adr/0014-user-product-platform.md.
//
// Convencoes desta secao:
//  - PK interna = BigInt autoincrement (D6), como o resto do schema.
//  - Todas as tabelas usam o prefixo `user_` (exceto `users`) para nao
//    colidir com o dominio editorial/catalogo.
//  - Refs polimorficas (entityType + entityId) ganham FK composta real
//    para `entities` via SQL bruto, como cast_members/entity_news_links.
//  - Default seguro: tudo nasce PRIVADO (visibility=private), review de
//    usuario nasce `pending`, snapshot de recomendacao nasce
//    is_current=false. Nada aqui e superficie publica indexavel:
//    paginas de usuario sao noindex por construcao e ficam fora de
//    sitemap (invariante 5, caso tecnico) — travado por governanca.
//  - `user_ratings` NAO tem relacao alguma com `external_ratings`:
//    nota de usuario nunca vira nota de fonte externa, nunca e
//    reescalada e nunca alimenta AggregateRating (invariantes 1/2 +
//    "sem AggregateRating falsa").
//  - Segredos NUNCA persistem em claro: sessoes e tokens de
//    verificacao guardam apenas hash; IP bruto nunca e gravado (apenas
//    hash com sal de servidor).
//  - CHECKs condicionais, indices unicos parciais e triggers de
//    append-only sao aplicados via SQL bruto na migration (D5).
// ============================================================

enum UserStatus {
  active
  disabled
  pending_deletion // exclusao LGPD solicitada; janela de arrependimento
  deleted // anonimizado; linha retida como tumba (sem dado pessoal)
}

enum UserRole {
  user
  moderator
  admin
}

enum ProfileVisibility {
  private
  public
}

// Visibilidade de conteudo gerado por usuario (listas, reviews, diario).
enum Visibility {
  private
  unlisted
  public
}

enum WatchState {
  planned
  watching
  watched
  paused
  dropped
  rewatching
  not_interested // alimenta exclusao em recomendacoes; nao e atividade
}

enum ViewingEventType {
  watch_started
  watch_completed
  episode_watched
  episode_unwatched
  progress_updated
  state_changed
  rewatch_started
  rating_set
  rating_removed
  review_created
  undo // desfazer preserva o evento original (diario append-only)
  import_applied
}

// Moderacao de review de USUARIO — enum proprio, sem relacao com o
// ReviewStatus editorial de content_blocks.
enum ReviewModerationStatus {
  pending
  approved
  rejected
  removed // removido por moderacao/soft delete; audit preservado
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

enum ThrottleScope {
  email
  ip
}

enum AuthAuditAction {
  signup
  login_succeeded
  login_failed
  logout
  session_rotated
  session_revoked
  all_sessions_revoked
  email_verification_sent
  email_verified
  password_reset_requested
  password_reset_completed
  password_changed
  lockout_triggered
  account_disabled
  account_reactivated
  deletion_requested
  deletion_cancelled
  account_anonymized
  data_export_requested
  data_export_completed
  import_applied
}

enum UserListKind {
  system // criada pelo produto (watchlist, favoritos, ...); nao deletavel
  custom
}

enum SystemListKey {
  watchlist // "quero assistir"
  favorites
  watching
  watched
}

enum ConsentKind {
  terms_of_service
  privacy_policy
  marketing_email
  analytics
}

enum DataRequestKind {
  export
  deletion
}

enum DataRequestStatus {
  pending
  processing
  completed
  rejected
  cancelled
}

enum ImportSource {
  letterboxd_csv
  trakt_export
  cinerie_json
  cinerie_csv
}

enum ImportJobStatus {
  uploaded
  parsed
  preview_ready
  resolving
  conflicts_pending
  applying
  applied
  failed
  cancelled
}

enum ReportReason {
  spam
  spoiler_unflagged
  harassment
  illegal_content
  other
}

enum ReportStatus {
  open
  reviewed
  dismissed
  actioned
}

// C7A — enums de RECOMENDACAO. Espelham VALOR A VALOR (e na mesma ordem) as
// unions fechadas ja existentes no dominio puro:
//  - RECOMMENDATION_CONTEXTS      (recommendations/types.ts)
//  - RECOMMENDATION_FEEDBACK_TYPES (recommendations/feedback.ts)
//  - FEEDBACK_SOURCES              (recommendations/feedback.ts)
// Divergencia e bug — travado por tests/governance/user-platform-enums-mirror.
enum RecommendationContext {
  discovery
  continue_watching
  rewatch
  similar
}

// `not_interested` e a UNICA ancorada nas decisoes de produto (secao 9, exclusao
// dura); as demais sao provisorias/versionadas no dominio (POLICY_GAP).
enum RecommendationFeedbackType {
  not_interested
  hide
  already_seen
  dismiss
  not_relevant
  like
  save
}

enum RecommendationFeedbackSource {
  app
  system
}

model User {
  id              BigInt     @id @default(autoincrement())
  email           String     @unique
  emailNormalized String     @unique @map("email_normalized") // lower(btrim(email)); anti-enumeracao usa sempre esta
  handle          String?    @unique // formato via CHECK (SQL bruto); minusculo
  displayName     String?    @map("display_name")
  role            UserRole   @default(user)
  status          UserStatus @default(active)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at") // anonimizacao LGPD; linha nunca some (audit)

  profile                 UserProfile?
  passwordCredential      PasswordCredential?
  accounts                Account[]
  sessions                UserSession[]
  verificationTokens      VerificationToken[]
  authAuditLogs           AuthAuditLog[]
  watchStates             UserWatchState[]
  episodeProgress         EpisodeProgress[]
  viewingEvents           ViewingEvent[]
  lists                   UserList[]
  ratings                 UserRating[]
  reviews                 UserReview[]
  reviewReports           ReviewReport[]
  blocksInitiated         UserBlock[]              @relation("user_block_blocker")
  blocksReceived          UserBlock[]              @relation("user_block_blocked")
  statsSnapshot           UserStatsSnapshot?
  recommendationSnapshots RecommendationSnapshot[]
  recommendationFeedback  RecommendationFeedback[]
  consentRecords          ConsentRecord[]
  dataRequests            DataRequest[]
  importJobs              ImportJob[]

  // CHECKs via SQL bruto: email com '@'; email_normalized = lower(btrim());
  // handle ~ '^[a-z0-9](?:[a-z0-9_]{1,28}[a-z0-9])?$'; display_name nao-vazio
  // quando presente; status deleted/pending_deletion coerente com deleted_at.
  @@index([status])
  @@map("users")
}

model UserProfile {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @unique @map("user_id")
  bio         String?
  avatarPath  String?           @map("avatar_path") // asset local; nunca URL externa no render
  locale      String            @default("pt-BR") // BCP-47 (CHECK de formato via SQL bruto)
  countryCode String?           @map("country_code") // ISO-3166-1 alpha-2 (CHECK via SQL bruto)
  timezone    String?
  visibility  ProfileVisibility @default(private) // default seguro: perfil privado
  // --- Preferencias de APRESENTACAO (Fase 10) ---
  // Sao controles que a tela 13 do canonico pede e que ate 20/08/2026 eram
  // OMITIDOS da interface por nao terem backend. A escolha anterior estava
  // certa (o cabecalho de `settings-panel.tsx` diz: "sem preferencia fake —
  // nunca toggle sem efeito"); o que faltava era a coluna.
  //
  // NAO HA COLUNA DE TEMA, e a ausencia e decisao: o produto e claro SEMPRE
  // (dono, 21/08/2026). O canonico nao tem uma unica tela escura e
  // `globals.css` nao tem mais regra de tema escuro — uma coluna `theme` aqui
  // guardaria escolha que nenhuma regra le. Removida pela migration
  // `20260821120000_drop_user_theme_preference`.
  //
  // TEXTO com CHECK, nao enum do Prisma: um enum novo obriga migration para
  // acrescentar valor e acopla o vocabulario de UI ao schema. Aqui o conjunto
  // fechado vive no CHECK e no parser do contrato, que e onde ele e lido.
  density     String            @default("comfortable") // comfortable | compact
  posterSize  String            @default("medium") @map("poster_size") // small | medium | large
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PasswordCredential {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @unique @map("user_id")
  passwordHash String   @map("password_hash") // formato PHC-like versionado (ex.: scrypt$N=...,r=...,p=...$salt$hash); NUNCA em log
  algorithm    String   @default("scrypt")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password_credentials")
}

// Preparo para OAuth (adapter): NENHUM provedor ativo sem decisao humana
// registrada. De proposito NAO guarda access/refresh tokens de provedor.
model Account {
  id                BigInt   @id @default(autoincrement())
  userId            BigInt   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_accounts")
}

model UserSession {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt    @map("user_id")
  tokenHash     String    @unique @map("token_hash") // sha256 hex do token opaco de 256 bits; token cru NUNCA persiste
  csrfTokenHash String    @map("csrf_token_hash") // double-submit vinculado a sessao; hash, nunca o token cru
  expiresAt     DateTime  @map("expires_at")
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  rotatedFromId BigInt?   @unique @map("rotated_from_id") // rotacao: sessao anterior da cadeia (1-1)
  ipHash        String?   @map("ip_hash") // hash com sal de servidor; IP bruto nunca persiste
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom UserSession? @relation("user_session_rotation", fields: [rotatedFromId], references: [id])
  rotatedTo   UserSession? @relation("user_session_rotation")

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model VerificationToken {
  id         BigInt           @id @default(autoincrement())
  userId     BigInt           @map("user_id")
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") // sha256 hex; token cru so trafega uma vez, nunca persiste
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at") // consumo atomico (replay-safe) no adapter
  createdAt  DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("user_verification_tokens")
}

// Brute force: janela deslizante por chave (email normalizado OU hash de IP),
// sem FK para users de proposito — cobre e-mail inexistente sem enumeracao.
model AuthThrottle {
  id              BigInt        @id @default(autoincrement())
  scope           ThrottleScope
  key             String // email normalizado ou ip_hash; NUNCA IP bruto
  failureCount    Int           @default(0) @map("failure_count")
  windowStartedAt DateTime      @default(now()) @map("window_started_at")
  lockedUntil     DateTime?     @map("locked_until")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@map("user_auth_throttles")
}

// Append-only (trigger via SQL bruto proibe UPDATE): senha/token NUNCA
// aparecem aqui. user_id e Restrict (nao SetNull): exclusao LGPD anonimiza a
// linha de users (tumba), nunca hard-delete — e SetNull seria um UPDATE
// bloqueado pelo proprio trigger append-only.
model AuthAuditLog {
  id        BigInt          @id @default(autoincrement())
  userId    BigInt?         @map("user_id")
  sessionId BigInt?         @map("session_id") // referencia informativa; sem FK (sessao pode ser removida)
  action    AuthAuditAction
  ipHash    String?         @map("ip_hash")
  userAgent String?         @map("user_agent")
  detail    Json?
  createdAt DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("user_auth_audit_logs")
}

// Estado ATUAL de acompanhamento (projecao mutavel); o historico vive em
// user_viewing_events (append-only). CHECK via SQL bruto: entity_type IN
// ('movie','tv') — temporada/episodio usam user_episode_progress.
model UserWatchState {
  id             BigInt     @id @default(autoincrement())
  userId         BigInt     @map("user_id")
  entityType     EntityType @map("entity_type") // ref polimorfica -> entities, FK via SQL bruto
  entityId       BigInt     @map("entity_id")
  status         WatchState
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  lastActivityAt DateTime   @default(now()) @map("last_activity_at")
  rewatchCount   Int        @default(0) @map("rewatch_count")
  visibility     Visibility @default(private) // default seguro
  version        Int        @default(1) // optimistic locking (Expected-Version)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([userId, status])
  @@map("user_watch_states")
}

model EpisodeProgress {
  id              BigInt    @id @default(autoincrement())
  userId          BigInt    @map("user_id")
  episodeId       BigInt    @map("episode_id") // FK real para episodes(id) via SQL bruto
  watched         Boolean   @default(false)
  watchedAt       DateTime? @map("watched_at")
  progressSeconds Int?      @map("progress_seconds") // CHECK >= 0 e <= duration quando ambos presentes
  durationSeconds Int?      @map("duration_seconds")
  version         Int       @default(1) // optimistic locking
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, episodeId])
  @@index([episodeId])
  @@map("user_episode_progress")
}

// Diario/historico append-only (trigger via SQL bruto proibe UPDATE).
// Idempotencia por (user_id, idempotency_key): reprocessar nao duplica.
model ViewingEvent {
  id             BigInt           @id @default(autoincrement())
  userId         BigInt           @map("user_id")
  entityType     EntityType       @map("entity_type") // ref polimorfica -> entities, FK via SQL bruto
  entityId       BigInt           @map("entity_id")
  eventType      ViewingEventType @map("event_type")
  occurredAt     DateTime         @map("occurred_at")
  source         String           @default("app") // app | import:letterboxd_csv | import:trakt_export | ...
  idempotencyKey String           @map("idempotency_key")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  // C7A.1 — a identidade idempotente inclui o TIPO do evento: uma operacao
  // (uma idempotencyKey) emite varios eventos IRMAOS, e o dominio garante que
  // nunca ha dois do mesmo eventType no mesmo plano (provado por varredura
  // exaustiva em tracking/__tests__/event-identity-contract.test.ts).
  // Ordem (user_id, idempotency_key, event_type) preserva o prefixo
  // (user_id, idempotency_key) — util para ler todos os eventos de UMA operacao.
  // `occurred_at` NAO entra na identidade (todos os irmaos compartilham o mesmo
  // instante), mas ENTRA na equivalencia de replay (viewing-events.sameContent).
  @@unique([userId, idempotencyKey, eventType])
  @@index([userId, occurredAt])
  @@index([entityType, entityId])
  @@map("user_viewing_events")
}

model UserList {
  id          BigInt         @id @default(autoincrement())
  ownerId     BigInt         @map("owner_id")
  kind        UserListKind   @default(custom)
  systemKey   SystemListKey? @map("system_key") // CHECK via SQL bruto: kind='system' <=> system_key NOT NULL
  title       String // CHECK nao-vazio via SQL bruto
  slug        String // CHECK formato kebab-case via SQL bruto
  description String?
  visibility  Visibility     @default(private) // default seguro; publica exige usuario verificado (servico)
  ordered     Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  deletedAt   DateTime?      @map("deleted_at") // soft delete; audit preservado

  owner User           @relation(fields: [ownerId], references: [id])
  items UserListItem[]

  // Indice unico PARCIAL via SQL bruto: (owner_id, system_key) WHERE
  // system_key IS NOT NULL — uma lista de sistema de cada tipo por usuario.
  @@unique([ownerId, slug])
  @@index([ownerId, kind])
  @@map("user_lists")
}

model UserListItem {
  id         BigInt     @id @default(autoincrement())
  listId     BigInt     @map("list_id")
  entityType EntityType @map("entity_type") // ref polimorfica -> entities, FK via SQL bruto
  entityId   BigInt     @map("entity_id")
  position   Int? // CHECK >= 0 via SQL bruto; reorder e transacional no servico
  note       String?
  addedAt    DateTime   @default(now()) @map("added_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  list UserList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("user_list_items")
}

// Nota PESSOAL do usuario (0.5..5.0, passo 0.5 — CHECK via SQL bruto).
// Sem qualquer relacao com external_ratings/rating_sources: nunca vira nota
// de fonte externa nem AggregateRating (invariantes 1/2).
model UserRating {
  id              BigInt     @id @default(autoincrement())
  userId          BigInt     @map("user_id")
  entityType      EntityType @map("entity_type") // CHECK via SQL bruto: <> 'person'
  entityId        BigInt     @map("entity_id")
  value           Decimal    @db.Decimal(2, 1) // CHECK: >= 0.5, <= 5.0, value*2 = floor(value*2)
  scale           Int        @default(5) // CHECK: = 5 (coluna existe para migracao futura registrada)
  containsSpoiler Boolean    @default(false) @map("contains_spoiler")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("user_ratings")
}

// Review de USUARIO: nasce pending + private (fail-closed); soft delete;
// nunca vira Review editorial nem schema.org sem decisao futura propria.
model UserReview {
  id              BigInt                 @id @default(autoincrement())
  userId          BigInt                 @map("user_id")
  entityType      EntityType             @map("entity_type") // CHECK via SQL bruto: <> 'person'
  entityId        BigInt                 @map("entity_id")
  title           String? // CHECK <= 200 chars via SQL bruto
  body            String // CHECK nao-vazio e <= 20000 chars via SQL bruto
  containsSpoiler Boolean                @default(false) @map("contains_spoiler")
  status          ReviewModerationStatus @default(pending)
  visibility      Visibility             @default(private)
  publishedAt     DateTime?              @map("published_at")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  deletedAt       DateTime?              @map("deleted_at") // soft delete; audit preservado

  user    User           @relation(fields: [userId], references: [id])
  reports ReviewReport[]

  @@index([userId])
  @@index([entityType, entityId, status])
  @@map("user_reviews")
}

model ReviewReport {
  id         BigInt       @id @default(autoincrement())
  reviewId   BigInt       @map("review_id")
  reporterId BigInt       @map("reporter_id")
  reason     ReportReason
  detail     String?
  status     ReportStatus @default(open)
  resolvedAt DateTime?    @map("resolved_at")
  resolvedBy String?      @map("resolved_by") // identidade humana; nunca "agent"/"system"
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  review   UserReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User       @relation(fields: [reporterId], references: [id])

  @@unique([reviewId, reporterId])
  @@index([status])
  @@map("user_review_reports")
}

model UserBlock {
  id        BigInt   @id @default(autoincrement())
  blockerId BigInt   @map("blocker_id")
  blockedId BigInt   @map("blocked_id") // CHECK via SQL bruto: blocker_id <> blocked_id
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("user_block_blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("user_block_blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

// Projecao ASSINCRONA de estatisticas (minutos, filmes, episodios, generos,
// decadas, streak, avaliacoes, listas) — cache reconstruivel, nunca calculada
// no request (zero trabalho pesado no render).
model UserStatsSnapshot {
  id               BigInt   @id @default(autoincrement())
  userId           BigInt   @unique @map("user_id")
  algorithmVersion String   @map("algorithm_version")
  computedAt       DateTime @map("computed_at")
  stats            Json
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats_snapshots")
}

// Snapshot PERSISTIDO de recomendacoes com explicacao (RecommendationReason
// por item) e versao de algoritmo. Historico imutavel; apenas is_current
// flipa (default seguro: false — o servico promove transacionalmente).
// C7A: `context`, `policy_version`, `fingerprint` e `expires_at` viraram COLUNAS
// (antes so existiam dentro do JSON `items`) porque o dominio C6B os usa como
// PRE-CONDICAO operacional: equivalencia (noop vs replace), renovacao,
// invalidacao e concorrencia.
// Indice unico PARCIAL via SQL bruto: (user_id, context) WHERE is_current = true
// — NAO representavel no Prisma; ver migration. O escopo do vigente passou a
// incluir o CONTEXTO (o dominio mantem 4 contextos independentes por usuario).
model RecommendationSnapshot {
  id               BigInt                @id @default(autoincrement())
  userId           BigInt                @map("user_id")
  context          RecommendationContext
  algorithmVersion String                @map("algorithm_version")
  policyVersion    String                @map("policy_version") // CHECK via SQL bruto: btrim <> ''
  // `null` = snapshot legado sem fingerprint. O adapter DEVE trata-lo como
  // NAO-equivalente (forca replace) — nunca como igual.
  fingerprint      String?
  generatedAt      DateTime              @map("generated_at")
  // `null` = sem TTL. CHECK via SQL bruto: expires_at >= generated_at.
  expiresAt        DateTime?             @map("expires_at")
  items            Json // [{entityType, entityId, score, reasons: RecommendationReason[]}]
  isCurrent        Boolean               @default(false) @map("is_current")
  createdAt        DateTime              @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isCurrent])
  // Historico/observabilidade: NAO unico (snapshots equivalentes sao legitimos).
  @@index([userId, context, fingerprint])
  @@map("user_recommendation_snapshots")
}

// Feedback EXPLICITO do usuario sobre uma recomendacao (C7A fecha o SCHEMA_GAP
// de C6B). Alimenta as exclusoes derivadas do dominio puro; NUNCA guarda texto
// livre, PII, nota, review nem estado de moderacao. Idempotencia por
// (user_id, idempotency_key), mesmo padrao de user_viewing_events.
model RecommendationFeedback {
  id             BigInt                       @id @default(autoincrement())
  userId         BigInt                       @map("user_id")
  entityType     EntityType                   @map("entity_type") // CHECK via SQL bruto: <> 'person'
  entityId       BigInt                       @map("entity_id")
  // `null` = feedback vale para TODOS os contextos.
  context        RecommendationContext?
  feedbackType   RecommendationFeedbackType   @map("feedback_type")
  source         RecommendationFeedbackSource
  occurredAt     DateTime                     @map("occurred_at")
  // `null` = permanente. CHECK via SQL bruto: expires_at > occurred_at.
  expiresAt      DateTime?                    @map("expires_at")
  idempotencyKey String                       @map("idempotency_key") // CHECK: btrim <> ''
  createdAt      DateTime                     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, entityType, entityId])
  @@map("user_recommendation_feedback")
}

// Consentimento LGPD append-only (trigger via SQL bruto proibe UPDATE):
// cada mudanca e uma NOVA linha com versao de politica.
model ConsentRecord {
  id            BigInt      @id @default(autoincrement())
  userId        BigInt      @map("user_id")
  kind          ConsentKind
  granted       Boolean
  policyVersion String      @map("policy_version")
  occurredAt    DateTime    @default(now()) @map("occurred_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, kind, occurredAt])
  @@map("user_consent_records")
}

// Solicitacoes LGPD (export/exclusao). processed_by e identidade humana.
model DataRequest {
  id          BigInt            @id @default(autoincrement())
  userId      BigInt            @map("user_id")
  kind        DataRequestKind
  status      DataRequestStatus @default(pending)
  requestedAt DateTime          @default(now()) @map("requested_at")
  processedAt DateTime?         @map("processed_at")
  processedBy String?           @map("processed_by") // identidade humana; nunca "agent"/"system"
  detail      Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, kind])
  @@index([status])
  @@map("user_data_requests")
}

// Importacao (Letterboxd CSV, Trakt export, Cinerie JSON/CSV).
// Fluxo: uploaded -> parsed -> preview_ready -> resolving ->
// conflicts_pending -> applying -> applied. NUNCA aplica sem preview.
model ImportJob {
  id            BigInt          @id @default(autoincrement())
  userId        BigInt          @map("user_id")
  source        ImportSource
  status        ImportJobStatus @default(uploaded)
  fileName      String?         @map("file_name")
  itemCount     Int             @default(0) @map("item_count") // CHECK >= 0 via SQL bruto
  conflictCount Int             @default(0) @map("conflict_count")
  appliedCount  Int             @default(0) @map("applied_count")
  preview       Json? // itens parseados + resolucao proposta; aplicacao exige aprovacao
  conflicts     Json?
  error         String?
  appliedAt     DateTime?       @map("applied_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@map("user_import_jobs")
}

// ============================================================
// EDITORIAL / NEWS PLATFORM (Prompt 10) — fontes, itens recebidos,
// proveniencia, deduplicacao e projecao publica de artigo.
//
// Regras e decisoes: docs/editorial/README.md (inclui o que NAO foi feito)
// Runbook operacional: docs/editorial/runbook.md

//
// Convencoes desta secao:
//  - `articles`/`article_translations`/`entity_news_links` JA existiam e NAO
//    sao remodelados; esta secao acrescenta a CADEIA DE ENTRADA (fonte -> item
//    recebido -> proveniencia) que faltava, sem CMS paralelo.
//  - Separacao conceitual obrigatoria: SOURCE != SOURCE ITEM != ARTICLE.
//    Conteudo recebido NUNCA e artigo publico da Cinerie; fonte externa NUNCA
//    e autor Cinerie.
//  - Retencao minima de terceiro: `source_items` guarda identidade, URL
//    canonica, metadados e FINGERPRINTS — nunca o corpo integral do artigo de
//    terceiro. `excerpt` e curto e limitado por CHECK no proprio banco.
//  - `EntityType` deliberadamente NAO ganha o valor `article` (artigos nao
//    entram em `entities`/`slugs`); a coexistencia entidade/artigo em
//    `search_documents` e `page_indexability_decisions` usa o discriminador
//    `PublicDocKind` + `article_id`, com uniques PARCIAIS por kind.
//  - Default seguro em tudo: fonte nasce `paused`, item nasce `received`.
//    Sem evidencia de identidade estavel NAO se funde (fail-closed).
// ============================================================

// Natureza tecnica da fonte editorial. Descreve COMO o material chega, nunca
// o direito de reproduzi-lo (isso vive em `useRights` + `source_licenses`).
enum EditorialSourceKind {
  rss_feed
  api_feed
  press_release
  official_site
  wire
  partner
  manual
}

// Ciclo de vida operacional de uma fonte. `paused` e o default seguro: uma
// fonte recem-cadastrada nao ingere ate decisao humana. `retired` para de
// ingerir mas PRESERVA a evidencia historica ja ligada a artigos.
enum EditorialSourceStatus {
  active
  paused
  retired
}

// O que a Cinerie pode fazer com o material da fonte. NAO e inferido: e uma
// decisao humana registrada. `unknown` (default) autoriza apenas rastrear a
// existencia do item — nunca exibir texto de terceiro em pagina publica.
enum EditorialSourceUseRights {
  unknown
  headline_and_link_only
  excerpt_with_attribution
  full_syndication
}

// Estagio de processamento de um item recebido. `discarded` cobre tanto o
// duplicado quanto o rejeitado por politica; o motivo vai em `discardReason`.
enum SourceItemStatus {
  received
  deduplicated
  linked
  discarded
  failed
}

// Veredito deterministico de deduplicacao. NAO existe fusao semantica:
// `duplicate` exige identidade ESTAVEL (mesmo source+external_id, mesma URL
// canonica normalizada ou mesmo fingerprint de conteudo). `related` e um
// sinal FRACO (mesma entidade + janela temporal) que NUNCA funde nem
// descarta — apenas agrupa para revisao humana.
enum SourceItemDedupVerdict {
  unique
  duplicate
  related
  superseded
}

// Papel de uma fonte na proveniencia de um artigo. Um artigo pode ter varias.
enum ArticleSourceRole {
  primary
  secondary
  press_release
  catalog
}

// Discriminador de documento publico. Existe porque `EntityType` NAO pode
// ganhar `article` (artigos nao vivem em `entities`), mas artigo e entidade
// coexistem nas MESMAS tabelas de busca e de indexabilidade — proibido criar
// um segundo search engine ou uma segunda tabela de indexabilidade.
enum PublicDocKind {
  entity
  article
}

// Fonte editorial registrada. Uma linha aqui significa "conhecemos e
// rastreamos esta fonte" — NUNCA "podemos reproduzir o conteudo dela".
// O direito de exibicao mora em `useRights` (decisao humana) e continua
// subordinado a `source_licenses` (invariante 6).
model EditorialSource {
  id          BigInt                   @id @default(autoincrement())
  slug        String                   @unique // identificador estavel e legivel (ex.: "collider")
  name        String
  domain      String                   @unique // host canonico, minusculo, sem www (CHECK via SQL bruto)
  homepageUrl String?                  @map("homepage_url")
  kind        EditorialSourceKind      @default(rss_feed)
  status      EditorialSourceStatus    @default(paused) // default seguro: nao ingere sozinha
  useRights   EditorialSourceUseRights @default(unknown) @map("use_rights") // default seguro (inv. 6)

  // Atribuicao: quando exigida, o artigo derivado so publica com credito/link.
  requiresAttribution Boolean @default(true) @map("requires_attribution")
  requiresLinkback    Boolean @default(true) @map("requires_linkback")
  attributionText     String? @map("attribution_text")

  // Politica de ingestao (janela, cadencia); parametros, nunca segredo.
  ingestPolicy   Json      @default("{}") @map("ingest_policy")
  lastIngestedAt DateTime? @map("last_ingested_at")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  items        SourceItem[]
  articleLinks ArticleSourceLink[]

  @@index([status])
  @@index([kind])
  @@map("editorial_sources")
}

// Item recebido de uma fonte. E a camada de AUDITORIA e IDENTIDADE da
// entrada — nao e um artigo e nunca vira pagina publica por si so.
//
// Retencao: guardamos identidade + metadados + fingerprints + um `excerpt`
// curto. O corpo integral de terceiro NAO e persistido; o CHECK de tamanho do
// excerpt trava isso no proprio banco.
model SourceItem {
  id            BigInt  @id @default(autoincrement())
  sourceId      BigInt  @map("source_id")
  // Identidade estavel do item NA FONTE. E a chave de idempotencia primaria:
  // reingerir o mesmo external_id atualiza, nunca duplica.
  externalId    String  @map("external_id")
  canonicalUrl  String? @map("canonical_url") // URL declarada pela fonte
  // URL canonica NORMALIZADA (minuscula, sem query de tracking, sem fragmento,
  // sem barra final): o eixo secundario de deduplicacao.
  normalizedUrl String? @map("normalized_url")
  title         String
  author        String?
  language      String?
  excerpt       String? // trecho curto; CHECK de tamanho via SQL bruto

  // Fingerprints deterministicos (sha-256 hex, 64 chars; CHECK via SQL bruto).
  contentFingerprint String? @map("content_fingerprint") // hash do texto normalizado
  payloadFingerprint String? @map("payload_fingerprint") // hash do payload cru recebido

  publishedAt     DateTime? @map("published_at")
  sourceUpdatedAt DateTime? @map("source_updated_at")
  fetchedAt       DateTime  @default(now()) @map("fetched_at")

  status        SourceItemStatus       @default(received)
  dedupVerdict  SourceItemDedupVerdict @default(unique) @map("dedup_verdict")
  // Quando `duplicate`/`superseded`, aponta para o item PRIMARIO retido.
  duplicateOfId BigInt?                @map("duplicate_of_id")
  discardReason String?                @map("discard_reason")
  metadata      Json                   @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source       EditorialSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  duplicateOf  SourceItem?         @relation("SourceItemDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates   SourceItem[]        @relation("SourceItemDuplicate")
  articleLinks ArticleSourceLink[]

  // Idempotencia de ingestao: (fonte, id externo) e unico.
  @@unique([sourceId, externalId])
  // Segundo eixo de dedup: a mesma URL normalizada nao entra duas vezes na
  // MESMA fonte. Unique PARCIAL (so quando normalized_url IS NOT NULL) via
  // SQL bruto — duas fontes diferentes cobrindo a mesma URL sao um sinal
  // legitimo de proveniencia, nao um erro de ingestao.
  @@index([normalizedUrl])
  @@index([contentFingerprint])
  @@index([status])
  @@index([sourceId, publishedAt])
  @@map("source_items")
}

// Proveniencia: quais fontes sustentam um artigo. Um artigo pode ter N
// fontes; a evidencia sobrevive a inativacao da fonte porque a FK para
// `editorial_sources` e RESTRICT e a linha nunca e apagada em cascata.
model ArticleSourceLink {
  id           BigInt            @id @default(autoincrement())
  articleId    BigInt            @map("article_id")
  sourceId     BigInt            @map("source_id")
  sourceItemId BigInt?           @map("source_item_id") // item exato, quando veio de um
  role         ArticleSourceRole @default(secondary)
  createdAt    DateTime          @default(now()) @map("created_at")

  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source     EditorialSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceItem SourceItem?     @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  // Unique PARCIAL adicional (SQL bruto): no maximo UMA fonte `primary` por
  // artigo, e no maximo uma linha por (artigo, fonte) quando sourceItemId e
  // NULL — NULL nao colide em unique composto do PostgreSQL.
  @@unique([articleId, sourceId, sourceItemId])
  @@index([articleId])
  @@index([sourceId])
  @@map("article_source_links")
}

/// Resultado de uma tentativa de projetar um evento do CMS no banco publico.
enum EditorialProjectionOutcome {
  applied /// o evento mudou o banco publico
  skipped_duplicate /// evento ja projetado antes (replay)
  skipped_stale /// versao mais nova ja projetada; evento antigo ignorado
  skipped_unlicensed /// bloqueado pela invariante 6 (sem licenca clara)
}

/// Recibo de projecao editorial (Payload -> banco publico).
///
/// E o REGISTRO DE IDEMPOTENCIA do consumidor da outbox. O worker grava o
/// recibo na MESMA transacao em que aplica a projecao: ou os dois existem, ou
/// nenhum. Um evento reentregue encontra o recibo e nao reaplica nada.
///
/// Tambem e a trilha de auditoria de quem publicou o que no site publico —
/// publicacao e decisao humana registrada (invariante 12), e o recibo prova
/// qual decisao do CMS gerou qual estado publico.
model EditorialProjectionReceipt {
  id               BigInt                     @id @default(autoincrement())
  /// Identificador do evento na outbox do CMS. UNICO: e a trava de replay.
  eventId          String                     @unique @map("event_id")
  /// Chave de idempotencia do produtor (quando informada).
  idempotencyKey   String?                    @map("idempotency_key")
  eventType        String                     @map("event_type")
  /// Documento de origem no Payload (aggregate do evento).
  aggregateId      String                     @map("aggregate_id")
  /// Ordem de EMISSAO do evento (id da linha na outbox do CMS).
  emissionSequence Int                        @map("emission_sequence")
  /// Artigo publico afetado. NULL quando o evento foi ignorado antes de
  /// resolver o artigo (ex.: bloqueio de licenca).
  articleId        BigInt?                    @map("article_id")
  /// Hash do conteudo publicado, para detectar reprojecao sem mudanca.
  contentVersion   String?                    @map("content_version")
  outcome          EditorialProjectionOutcome
  /// Quem projetou (identidade do worker), para auditoria operacional.
  workerId         String                     @map("worker_id")
  projectedAt      DateTime                   @default(now()) @map("projected_at")

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([aggregateId, emissionSequence])
  @@index([projectedAt])
  @@index([articleId])
  @@map("editorial_projection_receipts")
}

/// Estado de licenca de um asset editorial, espelhando o enum do CMS.
enum EditorialMediaLicenseStatus {
  unknown
  pending
  approved
  restricted
  expired
  prohibited
}

/// Asset de midia editorial JA PROJETADO para o armazenamento publico.
///
/// Nasce de um documento `media` aprovado no Payload, cujos BYTES foram pedidos
/// ao endpoint interno, verificados (assinatura, MIME real, dimensoes, hash) e
/// gravados por chave derivada do CONTEUDO. Nunca de uma URL arbitraria.
///
/// A deduplicacao e por `contentHash`: a mesma foto usada em dez materias ocupa
/// um arquivo so. `payloadMediaId` e unico porque um documento do CMS tem um
/// asset publico corrente — trocar o arquivo no CMS atualiza esta linha.
model EditorialMediaAsset {
  id             BigInt @id @default(autoincrement())
  /// Documento de origem no CMS. Ancora estavel entre reprojecoes.
  payloadMediaId String @unique @map("payload_media_id")
  /// sha256 dos bytes efetivamente gravados (formato `sha256:<hex>`).
  contentHash    String @map("content_hash")
  /// Chave no storage (`editorial/<xx>/<sha256>.<ext>`). Determinista.
  storageKey     String @unique @map("storage_key")
  /// Caminho publico servido pelo screen-app. NUNCA URL http(s).
  publicPath     String @unique @map("public_path")
  mimeType       String @map("mime_type")
  width          Int?
  height         Int?
  byteSize       Int    @map("byte_size")

  alt          String
  caption      String?
  credit       String?
  sourceName   String? @map("source_name")
  sourceUrl    String? @map("source_url")
  rightsHolder String? @map("rights_holder")

  licenseStatus       EditorialMediaLicenseStatus @default(unknown) @map("license_status")
  licenseReference    String?                     @map("license_reference")
  licenseExpiresAt    DateTime?                   @map("license_expires_at")
  requiresAttribution Boolean                     @default(true) @map("requires_attribution")
  allowedForEditorial Boolean                     @default(false) @map("allowed_for_editorial")
  allowedForHero      Boolean                     @default(false) @map("allowed_for_hero")
  allowedForSocial    Boolean                     @default(false) @map("allowed_for_social")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  heroOfArticles Article[] @relation("ArticleHeroMedia")

  @@index([contentHash])
  @@index([licenseStatus])
  @@map("editorial_media_assets")
}
