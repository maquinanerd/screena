// EDITORIAL / IA (polimorfico)
// ============================================================

model ContentBlock {
  id            BigInt           @id @default(autoincrement())
  entityType    EntityType       @map("entity_type")
  entityId      BigInt           @map("entity_id")
  languageCode  String           @map("language_code")
  blockType     ContentBlockType @map("block_type")
  content       String
  sourceType    ContentSource    @default(ai) @map("source_type")
  modelProvider String?          @map("model_provider") // obrigatorio se source_type != human (CHECK via SQL)
  modelName     String?          @map("model_name")
  promptVersion String           @map("prompt_version") // versionamento obrigatorio (inv. 8/13)
  inputHash     String           @map("input_hash")
  outputHash    String           @map("output_hash")
  reviewStatus  ReviewStatus     @default(draft) @map("review_status")
  warningsJson  Json?            @map("warnings_json")
  publishedAt   DateTime?        @map("published_at")
  createdAt     DateTime         @default(now()) @map("created_at")
