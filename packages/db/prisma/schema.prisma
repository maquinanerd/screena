  character    String?
  billingOrder Int?       @map("billing_order")
  creditId     String?    @unique @map("credit_id")
  // Guest star de episodio (TMDB separa `guest_stars` de `credits.cast`).
  // So faz sentido com entityType='episode'; nasce false para o elenco regular.
  isGuest      Boolean    @default(false) @map("is_guest")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

