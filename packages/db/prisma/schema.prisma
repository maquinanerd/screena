// Screena — Schema PostgreSQL (Fase 1).
//
// Convencoes (ver docs/PHASE_1_DATABASE_PLAN.md):
//  - Modelos PascalCase singular + @@map para tabela snake_case plural.
//  - Campos camelCase + @map para coluna snake_case.
//  - PK interna = BigInt autoincrement (D6); tabelas-semente usam chave natural.
//  - Refs polimorficas = (entityType + entityId), com @@index composto e FK
//    composta real para `entities(entityType, entityId)` (D1 evoluido em
//    2026-07 pelo hardening de governanca de dados; ver model `Entity`).
//  - rating_source e provider_api sao FKs DISTINTAS para tabelas DISTINTAS (invariante 2).
//  - Default seguro: tudo nasce noindex / display_allowed=false / unknown / draft.
//
// Restricoes que o Prisma NAO expressa (CHECKs condicionais e indices unicos
// PARCIAIS) sao aplicadas via SQL bruto na migration (D5); ver a secao
// "Database governance constraints not fully represented by Prisma" no plano.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (14)
// ============================================================

enum EntityType {
  movie
  tv
  season
  episode
  person
}

enum ContentBlockType {
  editorial_intro
  summary_without_spoilers
  ratings_explanation
  where_to_watch_text
  cast_intro
  similar_titles_intro
  franchise_context
  season_guide
  episode_context
  faq
  news_context
  review_summary
}

enum ContentSource {
  ai
  human
  hybrid
}

enum ReviewStatus {
  draft
  ai_generated
  needs_review
  human_reviewed
  published
  needs_update
  blocked
  archived
}

enum TranslationStatus {
  draft
  generated
  reviewed
  published
  noindex
  archived
}

enum IndexDecision {
  index
  noindex
  draft
  stale
  blocked
}

enum JobType {
  generate_block
  regenerate_block
  translate_block
}

enum JobStatus {
  queued
  claimed
  running
  completed
  failed
  blocked
  cancelled
}

enum LicenseStatus {
  official
  licensed
  third_party
  unknown
  blocked
}

// Discriminador de dominio de uma linha de source_licenses. Uma mesma fonte
// editorial (ex.: TMDB, RSSPRIME) pode ter politicas DIFERENTES por tipo de
// conteudo (rating vs texto de noticia vs imagem) e por territorio; o par
// (content_type, territory_code) faz parte da chave natural (ver hardening).
enum SourceLicenseContentType {
  rating
  watch_availability
  review
  video // trailers/teasers/clips/featurettes/etc. (Fase 7 — biblioteca de video TMDB)
  news
  image
  other
}

enum OfferType {
  subscription
  rent
  buy
  free
  ads
  cinema
}

enum SyncStatus {
  success
  partial
  failed
  empty
  aborted
}

enum ValidationStatus {
  passed
  warnings
  failed
}

enum ProviderKind {
  data
  ratings
  streaming
  ai
  news
}

// Ciclo de vida de um dado externo, do byte cru ate a exibicao (Backend B).
// Os quatro primeiros estagios descrevem o DADO (ainda nao ha decisao humana);
// os tres ultimos SAO decisoes registradas. `revoked` e terminal para aquela
// linha: reavaliar INSERE nova decisao (historico imutavel), nunca reabre a
// antiga.
enum DataUsageStage {
  raw
  recognized
  normalized
  license_pending
  approved_for_internal_use
  approved_for_display
  revoked
}

// Natureza editorial da nota. Separar critics de audience e a invariante 1 em
// outra roupa: Tomatometer (critica) e Popcornmeter (publico) sao metricas
// OPOSTAS da MESMA fonte — nunca se fundem nem trocam de rotulo.
enum RatingScoreType {
  critics
  audience
  editorial
}

// Resultado de um calculo de Cinerie Score. `blocked_by_decision` e resultado
// de PRIMEIRA CLASSE, nao erro: e o estado esperado enquanto a decisao de
// produto (docs/product/cinerie-score-decision.md) nao existir.
enum CinerieScoreStatus {
  calculated
  blocked_by_decision
}

// --- Raw sync TMDB (P0-00a): discriminador dedicado do payload bruto ---
// Superset de EntityType + tipos de referencia TMDB que NAO sao entidades
// renderizaveis do catalogo. NAO estende EntityType (contrato compartilhado).
enum TmdbEntityKind {
  movie
  tv
  season
  episode
  person
  collection
  network
  company
  keyword
}

// --- Catalogo em escala (Backend A): fila duravel de jobs ---
// Tipo do trabalho de catalogo. DISTINTO de JobType (writer-scoped:
// generate_block/regenerate_block/translate_block). Cobre o pipeline de
// ingestao/normalizacao (nunca redacao editorial). Worker-only.
enum CatalogJobType {
  bootstrap
  discover_ids
  sync_details
  sync_credits
  sync_external_ids
  sync_media
  sync_seasons
  sync_episodes
  sync_lists
  sync_changes
  reprocess_raw
}

// Estado de um CatalogJob na fila duravel. DISTINTO de JobStatus (writer).
// `retry_wait` = aguardando janela de backoff; `dead_letter` = esgotou
// tentativas (poison), aguardando replay humano/operacional.
enum CatalogJobStatus {
  pending
  claimed
  running
  retry_wait
  succeeded
  failed
  dead_letter
  cancelled
}

// ============================================================
// SEMENTE / REFERENCIA (chave natural como PK)
// ============================================================

model Language {
  code         String   @id // BCP-47 (pt-BR, en, es)
  namePt       String   @map("name_pt")
  nameEn       String   @map("name_en")
  isPublished  Boolean  @default(false) @map("is_published") // so pt-BR publica no MVP (inv. 9)
  indexDefault Boolean  @default(false) @map("index_default") // so pt-BR indexa por padrao (inv. 7/9)
  createdAt    DateTime @default(now()) @map("created_at")

  movies              Movie[]
  tvShows             TvShow[]
  translations        EntityTranslation[]
  slugs               Slug[]
  redirects           Redirect[]
  contentBlocks       ContentBlock[]
  writerJobs          EntityWriterJob[]
  indexDecisions      PageIndexabilityDecision[]
  articleTranslations ArticleTranslation[]

  @@map("languages")
}

model Country {
  code      String   @id // ISO 3166-1 alpha-2
  namePt    String   @map("name_pt")
  nameEn    String   @map("name_en")
  createdAt DateTime @default(now()) @map("created_at")

  watchAvailability  WatchAvailability[]
  sourceLicenses     SourceLicense[]
  dataUsageDecisions DataUsageDecision[]

  @@map("countries")
}

model RatingSource {
  key         String   @id // fonte editorial: imdb, rotten_tomatoes, metacritic, letterboxd, filmaffinity
  label       String
  scale       Int // espelha RATING_SCALES de @screena/config (travado por teste)
  homepageUrl String?  @map("homepage_url")
  createdAt   DateTime @default(now()) @map("created_at")

  ratings        ExternalRating[]
  sourceLicenses SourceLicense[]

  @@map("rating_sources")
}

model ApiProvider {
  key         String       @id // fornecedor tecnico: tmdb, gemini, imdb236, streaming_availability
  name        String
  kind        ProviderKind
  homepageUrl String?      @map("homepage_url")
  createdAt   DateTime     @default(now()) @map("created_at")

  ratings              ExternalRating[]
  syncLogs             ApiSyncLog[]
  cacheEntries         ApiCache[]
  sourceLicenses       SourceLicense[]
  watchProviderAliases WatchProviderAlias[]
  watchOffers          WatchAvailability[]

  @@map("api_providers")
}

// SourceLicense governa o que PODE ser exibido de uma fonte (invariante 6).
// Hardening (2026-07): `sourceKey` continua sendo o rotulo/identificador
// editorial em texto livre (cobre fontes sem tabela propria, como um outlet de
// noticia ou uma plataforma de streaming), mas quando `contentType = rating`
// a fonte DEVE ter uma linha verificavel em `rating_sources` via
// `ratingSourceKey` (FK real). `providerKey` (fornecedor tecnico) agora e uma
// FK real para `api_providers` — nunca o mesmo dominio de `ratingSourceKey`
// (invariante 2: RatingSource != ApiProvider).
model SourceLicense {
  id                  BigInt                   @id @default(autoincrement())
  sourceKey           String                   @map("source_key")
  contentType         SourceLicenseContentType @default(rating) @map("content_type")
  ratingSourceKey     String?                  @map("rating_source_key") // FK -> rating_sources.key; obrigatorio quando content_type=rating (CHECK)
  providerKey         String?                  @map("provider_key") // FK -> api_providers.key (fornecedor tecnico; NUNCA rating_source_key)
  territoryCode       String?                  @map("territory_code") // FK -> countries.code; null = licenca global
  licenseStatus       LicenseStatus            @default(unknown) @map("license_status") // default seguro (inv. 6)
  displayAllowed      Boolean                  @default(false) @map("display_allowed")
  logoAllowed         Boolean                  @default(false) @map("logo_allowed")
  scoreAllowed        Boolean                  @default(false) @map("score_allowed")
  reviewQuoteAllowed  Boolean                  @default(false) @map("review_quote_allowed")
  requiresAttribution Boolean                  @default(true) @map("requires_attribution")
  requiresLinkback    Boolean                  @default(true) @map("requires_linkback")
  attributionText     String?                  @map("attribution_text")
  termsUrl            String?                  @map("terms_url")
  validFrom           DateTime?                @map("valid_from") // inicio de vigencia (null = sem inicio definido)
  validUntil          DateTime?                @map("valid_until") // fim de vigencia (null = sem prazo definido)
  decidedBy           String?                  @map("decided_by") // identidade humana que decidiu a licenca
  decidedAt           DateTime?                @map("decided_at")
  // Historico imutavel de licenca (mesmo padrao de PageIndexabilityDecision):
  // cada reavaliacao INSERE nova linha; `is_current` marca a vigente por
  // (source_key, content_type, provider, territorio) via indice unico PARCIAL
  // (SQL bruto); `supersedes_id` liga a decisao anterior. Nenhuma linha antiga
  // e sobrescrita/apagada.
  isCurrent           Boolean                  @default(true) @map("is_current")
  supersedesId        BigInt?                  @map("supersedes_id")
  decisionOrigin      String?                  @map("decision_origin") // ex.: "seed", "human_override", "license_pipeline"
  policyVersion       String?                  @map("policy_version")
  notes               String?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  ratingSource RatingSource?   @relation(fields: [ratingSourceKey], references: [key])
  provider     ApiProvider?    @relation(fields: [providerKey], references: [key])
  territory    Country?        @relation(fields: [territoryCode], references: [code])
  supersedes   SourceLicense?  @relation("SourceLicenseHistory", fields: [supersedesId], references: [id])
  supersededBy SourceLicense[] @relation("SourceLicenseHistory")
  // Decisoes de USO derivadas desta licenca. A licenca diz o que a fonte
  // permite; a decisao diz para QUE USO isso vale (ver DataUsageDecision).
  usageDecisions DataUsageDecision[]

  // Licenca VIGENTE unica por (source_key, content_type, provider, territorio)
  // via indice unico PARCIAL WHERE is_current (SQL bruto); historico livre.
  @@index([sourceKey])
  @@index([contentType])
  @@index([ratingSourceKey])
  @@index([providerKey])
  @@index([territoryCode])
  @@index([isCurrent])
  @@index([supersedesId])
  @@map("source_licenses")
}

// DataUsageDecision — o eixo USE CASE da governanca de dados (Backend B).
//
// Por que existe, sendo que ja ha SourceLicense: `source_licenses` responde "o
// que esta fonte permite para este content_type neste territorio". NAO responde
// "para QUE USO", "pode ARMAZENAR?" nem "pode DERIVAR obra nova?". Esses tres
// eixos sao exatamente o que separa guardar-para-auditoria de exibir-em-pagina
// de derivar-um-Cinerie-Score. Por isso esta tabela e FILHA da licenca (FK
// real), nao uma copia dela.
//
// Teto inviolavel (trigger `data_usage_decisions_guard`): uma decisao NUNCA
// concede mais do que a licenca-mae vigente permite. Sem esse teto, o eixo
// use_case seria uma porta dos fundos para lavar dado sem licenca — bastaria
// criar uma decisao "approved_for_display" sobre uma licenca `unknown`.
//
// Escada de permissao (CHECKs no banco): display => storage; derivative =>
// storage; display => stage=approved_for_display; revoked => nada permitido.
model DataUsageDecision {
  id              BigInt         @id @default(autoincrement())
  sourceLicenseId BigInt         @map("source_license_id")
  useCase         String         @map("use_case") // ver DATA_USAGE_CASES em @screena/config
  territory       String? // FK -> countries.code; null = decisao global
  stage           DataUsageStage @default(license_pending)
  // Flags de uso. Todas fail-closed por default: nada nasce permitido.
  displayAllowed      Boolean   @default(false) @map("display_allowed")
  storageAllowed      Boolean   @default(false) @map("storage_allowed")
  derivativeAllowed   Boolean   @default(false) @map("derivative_allowed")
  attributionRequired Boolean   @default(true) @map("attribution_required")
  linkbackRequired    Boolean   @default(true) @map("linkback_required")
  validFrom           DateTime  @default(now()) @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  policyVersion       String    @map("policy_version")
  decidedBy           String    @map("decided_by") // identidade humana; nunca "agent"/"system"
  reason              String // por que esta decisao existe (auditoria)
  // Historico imutavel, mesmo padrao de SourceLicense/PageIndexabilityDecision.
  supersedesId BigInt?  @map("supersedes_id")
  isCurrent    Boolean  @default(true) @map("is_current")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sourceLicense SourceLicense       @relation(fields: [sourceLicenseId], references: [id])
  territoryRef  Country?            @relation(fields: [territory], references: [code])
  supersedes    DataUsageDecision?  @relation("DataUsageDecisionHistory", fields: [supersedesId], references: [id])
  supersededBy  DataUsageDecision[] @relation("DataUsageDecisionHistory")
  ratings       ExternalRating[]
  watchOffers   WatchAvailability[]

  // Decisao VIGENTE unica por (licenca, uso, territorio) via indice unico
  // PARCIAL WHERE is_current (SQL bruto na migration); historico livre.
  @@index([sourceLicenseId])
  @@index([useCase])
  @@index([territory])
  @@index([stage])
  @@index([isCurrent])
  @@index([supersedesId])
  @@map("data_usage_decisions")
}

// WatchProvider — identidade CANONICA de uma plataforma de streaming.
//
// Nao confundir com ApiProvider (invariante 2): `api_providers` e o fornecedor
// TECNICO que transportou o byte (ex.: streaming_availability/RapidAPI);
// `watch_providers` e a plataforma que o usuario reconhece (ex.: Netflix). Antes
// disto, `watch_availability.provider_name` era string crua do upstream —
// "Netflix", "netflix" e "Netflix Brasil" viravam tres plataformas na vitrine.
model WatchProvider {
  id            BigInt   @id @default(autoincrement())
  canonicalName String   @map("canonical_name")
  slug          String   @unique // ^[a-z0-9]+(-[a-z0-9]+)*$ (CHECK no banco)
  logoAssetId   String?  @map("logo_asset_id") // referencia opaca de asset; exibir logo exige logo_allowed na licenca
  homepageUrl   String?  @map("homepage_url") // HTTPS obrigatorio (CHECK)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aliases WatchProviderAlias[]
  offers  WatchAvailability[]

  @@map("watch_providers")
}

// WatchProviderAlias — como CADA fornecedor tecnico chama esse provedor.
// O unique (providerApi, externalKey) e o que impede dois provedores canonicos
// reivindicarem a mesma chave upstream.
model WatchProviderAlias {
  id          BigInt   @id @default(autoincrement())
  providerId  BigInt   @map("provider_id")
  providerApi String   @map("provider_api") // FK -> api_providers.key (fornecedor TECNICO)
  externalKey String   @map("external_key") // chave crua do upstream (ex.: service.id)
  displayName String   @map("display_name") // como o upstream exibe (auditoria/diagnostico)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  provider WatchProvider @relation(fields: [providerId], references: [id])
  api      ApiProvider   @relation(fields: [providerApi], references: [key])

  @@unique([providerApi, externalKey])
  @@index([providerId])
  @@map("watch_provider_aliases")
}

// CinerieScoreCalculation — historico versionado do Cinerie Score.
//
// ATENCAO: NAO ha formula decidida. Escala, fontes, pesos, votos minimos e
// arredondamento sao decisao HUMANA pendente em
// docs/product/cinerie-score-decision.md. Este model entrega o esqueleto
// auditavel (historico + versao + hash das entradas + explicacao) e registra o
// estado `blocked_by_decision` enquanto a decisao nao existir. O trigger
// `cinerie_score_display_guard` impede preencher producao antes disso.
//
// "Screen Score" e o nome TECNICO legado das colunas em movies/tv_shows; o nome
// PUBLICO e Cinerie Score e nunca aparece como "Screen Score" ao usuario.
model CinerieScoreCalculation {
  id            BigInt             @id @default(autoincrement())
  entityType    EntityType         @map("entity_type")
  entityId      BigInt             @map("entity_id")
  status        CinerieScoreStatus
  value         Decimal?           @db.Decimal(6, 3)
  scale         Int?
  version       String // versao da formula (ex.: "cinerie-score/v0-blocked")
  inputsHash    String             @map("inputs_hash") // hash das notas de entrada; recalculo identico nao polui historico
  explanation   Json? // por fonte: normalizado + peso (obrigatorio quando calculated)
  blockedReason String?            @map("blocked_reason") // obrigatorio quando blocked_by_decision
  calculatedAt  DateTime           @map("calculated_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@unique([entityType, entityId, version, inputsHash])
  @@index([entityType, entityId])
  @@index([version])
  @@index([status])
  @@index([calculatedAt])
  @@map("cinerie_score_calculations")
}

// ============================================================
// MIDIA (entidades-raiz)
// ============================================================

model Movie {
  id                 BigInt    @id @default(autoincrement())
  tmdbId             Int       @unique @map("tmdb_id")
  imdbId             String?   @unique @map("imdb_id") // 'tt#######'; identificador, NAO fonte de rating
  titleOriginal      String    @map("title_original")
  originalLanguage   String?   @map("original_language")
  releaseDate        DateTime? @map("release_date") @db.Date
  runtimeMinutes     Int?      @map("runtime_minutes")
  status             String?
  popularity         Decimal?
  voteAverageTmdb    Decimal?  @map("vote_average_tmdb") // dado tecnico TMDB; NUNCA nota editorial (inv. 1/2)
  voteCountTmdb      Int?      @map("vote_count_tmdb")
  posterPath         String?   @map("poster_path")
  backdropPath       String?   @map("backdrop_path")
  // Classificacao indicativa (advisory de conteudo: "14", "16", "L", "TV-MA").
  // NAO e rating source; nao passa pelas regras de external_ratings (inv. 1/2).
  certification      String?   @map("certification")
  // Nota editorial PROPRIA da Cinerie (escala 5). Nunca e AggregateRating de
  // terceiro nem se mistura com IMDb/RT. `screen_score_display` e o gate seguro
  // (nasce false): so aparece em pagina publica quando explicitamente liberado.
  screenScore        Decimal?  @map("screen_score")
  screenScoreScale   Int?      @map("screen_score_scale")
  screenScoreDisplay Boolean   @default(false) @map("screen_score_display")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  staleAfter         DateTime? @map("stale_after")

  language              Language?                   @relation(fields: [originalLanguage], references: [code])
  collectionMemberships MovieCollectionMembership[]
  productionCompanies   MovieProductionCompany[]

  @@index([status])
  @@index([updatedAt])
  @@index([releaseDate])
  @@index([popularity])
  @@index([staleAfter])
  @@index([originalLanguage])
  @@map("movies")
}

model TvShow {
  id                 BigInt    @id @default(autoincrement())
  tmdbId             Int       @unique @map("tmdb_id")
  imdbId             String?   @unique @map("imdb_id")
  nameOriginal       String    @map("name_original")
  originalLanguage   String?   @map("original_language")
  firstAirDate       DateTime? @map("first_air_date") @db.Date
  lastAirDate        DateTime? @map("last_air_date") @db.Date
  status             String?
  numberOfSeasons    Int?      @map("number_of_seasons")
  numberOfEpisodes   Int?      @map("number_of_episodes")
  popularity         Decimal?
  voteAverageTmdb    Decimal?  @map("vote_average_tmdb")
  voteCountTmdb      Int?      @map("vote_count_tmdb")
  posterPath         String?   @map("poster_path")
  backdropPath       String?   @map("backdrop_path")
  // Classificacao indicativa (advisory de conteudo). NAO e rating source (inv. 1/2).
  certification      String?   @map("certification")
  // Nota editorial PROPRIA da Cinerie (escala 5); gate seguro nasce false (inv. 6).
  screenScore        Decimal?  @map("screen_score")
  screenScoreScale   Int?      @map("screen_score_scale")
  screenScoreDisplay Boolean   @default(false) @map("screen_score_display")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  staleAfter         DateTime? @map("stale_after")

  language            Language?             @relation(fields: [originalLanguage], references: [code])
  seasons             Season[]
  networks            TvNetwork[]
  productionCompanies TvProductionCompany[]

  @@index([status])
  @@index([updatedAt])
  @@index([firstAirDate])
  @@index([lastAirDate])
  @@index([popularity])
  @@index([staleAfter])
  @@index([originalLanguage])
  @@map("tv_shows")
}

model Season {
  id           BigInt    @id @default(autoincrement())
  tvShowId     BigInt    @map("tv_show_id")
  tmdbId       Int?      @map("tmdb_id")
  seasonNumber Int       @map("season_number")
  name         String?
  overview     String?
  airDate      DateTime? @map("air_date") @db.Date
  episodeCount Int?      @map("episode_count")
  posterPath   String?   @map("poster_path")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastSyncedAt DateTime? @map("last_synced_at")

  tvShow   TvShow    @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([id, tvShowId]) // alvo da FK composta de episodes (forca tv_show_id coerente)
  @@unique([tvShowId, seasonNumber])
  @@index([tvShowId])
  @@map("seasons")
}

model Episode {
  id             BigInt    @id @default(autoincrement())
  seasonId       BigInt    @map("season_id")
  tvShowId       BigInt    @map("tv_show_id")
  tmdbId         Int?      @map("tmdb_id")
  episodeNumber  Int       @map("episode_number")
  name           String?
  overview       String?
  airDate        DateTime? @map("air_date") @db.Date
  runtimeMinutes Int?      @map("runtime_minutes")
  stillPath      String?   @map("still_path")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastSyncedAt   DateTime? @map("last_synced_at")

  // Episode NAO armazena season_number: ele e DERIVADO de seasons via season_id
  // (evita divergencia episodio x temporada). A FK COMPOSTA abaixo tambem garante
  // que o tv_show_id do episodio bate com o da season (denormalizacao controlada,
  // sem dado de temporada redundante).
  season Season @relation(fields: [seasonId, tvShowId], references: [id, tvShowId], onDelete: Cascade)

  @@unique([seasonId, episodeNumber])
  @@index([tvShowId])
  @@map("episodes")
}

model Person {
  id                    BigInt        @id @default(autoincrement())
  tmdbId                Int           @unique @map("tmdb_id")
  imdbId                String?       @unique @map("imdb_id")
  name                  String
  knownForDepartment    String?       @map("known_for_department")
  gender                Int?
  birthday              DateTime?     @db.Date
  deathday              DateTime?     @db.Date
  placeOfBirth          String?       @map("place_of_birth")
  profilePath           String?       @map("profile_path")
  biographySourceStatus LicenseStatus @default(unknown) @map("biography_source_status") // governa EXIBICAO da bio (inv. 6)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  lastSyncedAt          DateTime?     @map("last_synced_at")

  castCredits CastMember[]
  crewCredits CrewMember[]

  @@index([updatedAt])
  @@map("people")
}

// ============================================================
// REGISTRO DE ENTIDADES (supertipo das refs polimorficas)
// ============================================================
// Evolucao de D1 (docs/PHASE_1_DATABASE_PLAN.md, secao 6.3.1): as refs
// polimorficas (entity_type + entity_id) espalhadas pelo schema deixam de
// depender so de "limpeza de orfaos no worker" e passam a ter integridade
// real de banco. `entities` e uma tabela de REGISTRO fina — SEM colunas
// proprias alem da chave composta — mantida por TRIGGERS a partir de
// movies/tv_shows/seasons/episodes/people (ver migration
// 20260715120000_data_governance_hardening). Toda tabela polimorfica ganha
// FK composta (entity_type, entity_id) -> entities(entity_type, entity_id)
// via SQL bruto (D5), impedindo IDs orfaos sem exigir mudanca no app.
model Entity {
  entityType EntityType @map("entity_type")
  entityId   BigInt     @map("entity_id")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@id([entityType, entityId])
  @@map("entities")
}

// ============================================================
// CREDITOS (polimorfico -> movie | tv)
