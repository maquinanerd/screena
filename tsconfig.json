{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/**/*.ts",
    "api-clients/**/*.ts",
    "services/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "coverage",
    "packages/**/prisma/**",
    "packages/**/scripts/**",
    "packages/db/src/server.ts",
    "api-clients/**/bin/**",
    "services/**/persistence/**",
    "services/**/bin/**",
    "services/ingestion/src/composition.ts"
  ]
}
