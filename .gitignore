# Dependencias
node_modules
.pnpm-store

# Build / output
.next
dist
build
coverage
.turbo
.vitest

# Imagens reais baixadas do TMDB pela ingestao (arte de estudio, regeravel).
# NUNCA commitar: rode services/ingestion/bin/ingest-public-catalog.ts p/ gerar.
apps/web/public/media/tmdb/

# Artefatos de descoberta de IDs (fila de sync regeravel dos Daily ID Exports).
# NUNCA commitar: rode services/ingestion/bin/discover-ids.ts --apply p/ gerar.
services/ingestion/.data/

# Samples e relatorios dos workers RapidAPI (payload de terceiro + diagnostico).
# NUNCA commitar: sao regeraveis via --sample/--dry-run e podem conter dado de
# provider externo. As chaves ja sao sanitizadas, mas o payload nao e nosso.
services/ratings/.data/
services/streaming/.data/

# Artefatos gerados pelo Next (next build / next lint)
next-env.d.ts
*.tsbuildinfo

# Capturas do QA visual da home (regeraveis por `pnpm --filter @screena/web qa:home-fold`)
apps/web/.qa-home-fold/
apps/web/.qa-home-editorial/

# Ambiente — chaves vivem SO em env vars, nunca versionadas
.env
.env.*
!.env.example

# Logs
*.log

# Artefatos de backup do PostgreSQL (dados sensiveis/licenciados)
/backups/
*.dump
*.dump.sha256
*.dump.gz
*.sql.gz
*.dump.gz.sha256

# Python workers
__pycache__/
.venv/

# Sistema
.DS_Store
desktop.ini

# Local agent/runtime artifacts
# Residuo local do Ruflo/Claude Flow (daemon, memoria, banco vetorial, config
# resolvida na maquina). Nunca commitar: pode conter trechos do codigo indexado.
# O restante de .claude/ (rules, skills, agents) CONTINUA versionado.
.claude-flow/
.swarm/
ruvector.db
.claude/.proven-config-version
.claude/proven-config.json

# Uploads locais do CMS (desenvolvimento/teste). Nunca versionados.
#
# Os padroes sao ANCORADOS de proposito. Um `media/` solto casa em QUALQUER
# profundidade e engoliria codigo-fonte: `services/news-ingestion/src/media/`
# (o pipeline de projecao de midia) sairia inteiro de um commit sem nenhum
# aviso — foi exatamente o que quase aconteceu na FASE 2D.
apps/cms/media/
/media/
services/*/media/

# Saida do Playwright (traces, screenshots e relatorio do E2E do painel).
#
# ANCORADO no diretorio do CMS, e nao um `test-results/` solto: o padrao solto
# casaria em qualquer profundidade e poderia engolir um diretorio de fonte com
# esse nome — a mesma armadilha do `media/` logo acima.
apps/cms/test-results/
apps/cms/playwright-report/
apps/cms/.playwright/
