{
  "name": "screena",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "description": "Cinerie — base global de entretenimento entity-first (filmes, series, pessoas, ratings, onde assistir, noticias) com camada editorial propria. Namespace tecnico legado: @screena/*.",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=9.15.4 <10"
  },
  "scripts": {
    "build": "corepack pnpm --filter @screena/web build",
    "start": "corepack pnpm --filter @screena/web start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:catalog-runtime": "tsc -p tsconfig.runtime.json --noEmit",
    "typecheck:web": "corepack pnpm --filter @screena/web typecheck",
    "typecheck:admin": "corepack pnpm --filter @screena/admin typecheck",
    "typecheck:apps": "corepack pnpm run typecheck:web && corepack pnpm run typecheck:admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:invariants": "node scripts/audit/check-invariants.mjs",
    "audit:render": "node scripts/audit/check-render-purity.mjs",
    "api:coverage": "node scripts/audit/check-api-coverage.mjs",
    "validate:tmdb-platform": "corepack pnpm --filter @screena/ingestion validate:tmdb-platform",
    "validate:catalog-platform-complete": "corepack pnpm --filter @screena/ingestion validate:catalog-platform-complete",
    "validate:external-intelligence-platform": "corepack pnpm --filter @screena/entity-writer validate:external",
    "validate:external-intelligence-product": "corepack pnpm --filter @screena/ratings validate:product",
    "validate:editorial-platform": "corepack pnpm --filter @screena/news-ingestion validate:editorial-platform",
    "validate:news-pages": "corepack pnpm --filter @screena/web validate:news-pages",
    "validate:entity-indexes": "corepack pnpm --filter @screena/web validate:entity-indexes",
    "validate:movie-page": "corepack pnpm --filter @screena/web validate:movie-page",
    "validate:series-page": "corepack pnpm --filter @screena/web validate:series-page",
    "validate:person-page": "corepack pnpm --filter @screena/web validate:person-page",
    "validate:all": "corepack pnpm --filter @screena/web validate:all",
    "catalog": "corepack pnpm --filter @screena/ingestion catalog",
    "ratings": "corepack pnpm --filter @screena/ratings ratings",
    "legal": "corepack pnpm --filter @screena/legal legal",
    "validate:source-authorization-and-attribution": "corepack pnpm --filter @screena/legal validate:source-authorization"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
