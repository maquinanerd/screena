{
  "name": "@screena/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "App publico do Screen (Next.js App Router). Namespace tecnico legado: @screena/web. Renderiza paginas indexaveis lendo apenas PostgreSQL/cache local. Zero API externa e zero Gemini no render.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate:movie-page": "tsx scripts/validate-movie-page-real-postgres.ts",
    "validate:series-page": "tsx scripts/validate-series-page-real-postgres.ts",
    "validate:person-page": "tsx scripts/validate-person-page-real-postgres.ts",
    "validate:entity-indexes": "tsx scripts/validate-entity-indexes-real-postgres.ts",
    "validate:news-pages": "tsx scripts/validate-news-pages-real-postgres.ts",
    "validate:seo-runtime": "tsx scripts/validate-seo-runtime-real-postgres.ts",
    "validate:all": "tsx scripts/validate-all-real-postgres.ts",
    "seed:dev-movie": "tsx scripts/seed-dev-movie.ts",
    "gen:demo-media": "node scripts/generate-demo-media.mjs"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@screena/seo": "workspace:*",
    "@screena/ui": "workspace:*",
    "@screena/types": "workspace:*",
    "@screena/db": "workspace:*"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "@types/react": "^19.0.0",
    "@types/node": "^22.0.0",
    "embedded-postgres": "16.14.0-beta.17",
    "tsx": "^4.19.0"
  }
}
