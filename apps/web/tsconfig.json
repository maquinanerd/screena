{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    // Exigido pelo SWC/Next ao compilar a app real.
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // Plugin do Next: habilitado agora que a primeira pagina real existe.
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `scripts/` sao dev tools descartaveis (embedded-postgres, fora do render e
  // do bundle) — excluidos do typecheck, como os validate-real-postgres de
  // packages/db e services/entity-writer.
  "exclude": ["node_modules", "scripts"]
}
