{
  "name": "@screena/sync",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Orquestracao de sincronizacao: politica de frescor (stale) e o AGENDADOR de ingestao (tabela de ritmos, trava contra execucao dupla, cota, alerta de fila parada, painel de estado). Worker-only, offline; NUNCA no render.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./coverage": "./src/scheduler/runtime/coverage.ts",
    "./facts": "./src/scheduler/runtime/facts.ts",
    "./panel": "./src/scheduler/runtime/queue-panel.ts",
    "./admin-action-plan": "./src/scheduler/admin-action-plan.ts",
    "./admin-actions": "./src/scheduler/runtime/admin-actions.ts"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "dependencies": {
    "@screena/config": "workspace:*",
    "@screena/db": "workspace:*",
    "@screena/ingestion": "workspace:*",
    "@screena/tmdb-client": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0"
  },
  "scripts": {
    "scheduler:start": "exec node --import tsx bin/cinerie-scheduler.ts",
    "ingestion:status": "tsx bin/ingestion-status.ts",
    "cache:purge": "tsx bin/purge-api-cache.ts",
    "prove:scheduler-lock": "tsx scripts/prove-scheduler-lock.ts",
    "prove:scheduler-service": "tsx scripts/prove-scheduler-service.ts",
    "prove:queue-drains": "tsx scripts/prove-queue-drains.ts"
  }
}
