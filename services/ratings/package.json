{
  "name": "@screena/ratings",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Worker offline de ratings externos: consome fornecedores tecnicos (RapidAPI) e persiste em external_ratings com fonte editorial reatribuida. Worker-only; NUNCA no render. Nasce com display_allowed=false e license_status=unknown.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "scripts": {
    "ratings": "tsx bin/ratings.ts",
    "ratings:omdb": "tsx bin/sync-omdb-ratings.ts",
    "awards:promote": "tsx bin/promote-omdb-awards.ts",
    "validate:omdb": "tsx scripts/validate-omdb-ratings-real-postgres.ts",
    "validate:awards": "tsx scripts/validate-omdb-awards-real-postgres.ts",
    "validate:product": "tsx scripts/validate-external-intelligence-product.ts"
  },
  "dependencies": {
    "@screena/config": "workspace:*",
    "@screena/db": "workspace:*",
    "@screena/film-show-ratings-client": "workspace:*",
    "@screena/legal": "workspace:*",
    "@screena/omdb-client": "workspace:*",
    "@screena/rapidapi-core": "workspace:*",
    "@screena/schemas": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "@screena/cinerie-score": "workspace:*",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0"
  }
}
