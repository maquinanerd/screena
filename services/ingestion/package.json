{
  "name": "@screena/ingestion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servico de ingestao de entidades (Fase 2): normaliza payloads TMDB e persiste no PostgreSQL via Prisma. Worker-only, offline; NUNCA no render. Normalizers puros + adapters Prisma isolados.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/composition.ts"
  },
  "sideEffects": false,
  "license": "UNLICENSED",
  "scripts": {
    "validate:tmdb-platform": "tsx scripts/validate-tmdb-platform-real-postgres.ts",
    "validate:tmdb-catalog": "tsx scripts/validate-tmdb-platform-real-postgres.ts",
    "validate:catalog-platform-complete": "tsx scripts/validate-catalog-platform-real-postgres.ts",
    "catalog": "tsx bin/catalog.ts",
    "validate:indexability-producer": "tsx scripts/validate-indexability-producer-real-postgres.ts"
  },
  "dependencies": {
    "@screena/db": "workspace:*",
    "@screena/public-contracts": "workspace:*",
    "@screena/tmdb-client": "workspace:*",
    "@screena/seo": "workspace:*"
  },
  "devDependencies": {
    "@prisma/client": "^6.1.0",
    "embedded-postgres": "16.14.0-beta.17",
    "prisma": "^6.1.0",
    "tsx": "^4.19.0"
  }
}
